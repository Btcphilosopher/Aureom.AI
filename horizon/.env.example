# Copier en .env puis remplacer les valeurs. Ne jamais committer .env.
# Valeurs de DÉMONSTRATION uniquement — aucun identifiant bancaire réel n'est requis ni accepté.
POSTGRES_PASSWORD=horizon-demo-db-password
HORIZON_SECRET_KEY=change-me-demo-only-secret-key-at-least-32-chars
HORIZON_SIMULATOR_WEBHOOK_SECRET=change-me-demo-simulator-secret
# Reproduit l'état de la maquette (lot de 480 000 € en attente) au premier démarrage
HORIZON_BOOTSTRAP_MOCKUP_STATE=true
