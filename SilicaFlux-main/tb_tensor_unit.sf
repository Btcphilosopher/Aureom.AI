//==============================================================================
//  tb_tensor_unit.sf
//------------------------------------------------------------------------------
//  Self-checking, cycle-accurate verification environment for the SilicaFlux
//  N x N (default 4 x 4) signed integer matrix-multiply engine tensor_unit.sf.
//  Silica Flux-2017 (IEEE 1800-2017 language semantics).
//
//  Environment structure
//    stimulus   : known-answer, identity, diagonal, zero, permutation, value
//                 sweep, outer-product walk, boundary, class cross, random,
//                 saturation, occupancy sweep, flush, reset, determinism
//    driver     : valid/ready transaction driver, flush pulse, idle scrambling
//    monitor    : one edge-sampling process, ordered accept -> complete -> flush
//    reference  : exact behavioural C = A x B (explicit i/j/k loops), itself
//                 cross-checked against closed forms on structured operands
//    scoreboard : ordered in-flight queue {id, A, B, C_exp, issue cycle,
//                 issue context}, latency alignment, element-level diagnosis
//    coverage   : explicit-bin functional coverage with closure enforcement
//
//  DUT contract (tensor_unit.sf)
//    parameters : N, DATA_W, ACC_W, LATENCY
//    clk, rst_n                    active-low reset, clears every in-flight op
//    in_valid -> / <- in_ready     accept = in_valid & in_ready
//    in_a, in_b [N*N*DATA_W-1:0]   row-major, element (r,c) at [(r*N+c)*DATA_W +: DATA_W]
//    flush                         one-cycle pulse, never coincident with in_valid;
//                                  drops every accepted op whose result has not
//                                  been presented before that edge
//    out_valid                     one strobe per surviving op, issue order
//    out_c      [N*N*ACC_W-1:0]    row-major, element (r,c) at [(r*N+c)*ACC_W +: ACC_W]
//
//  Arithmetic contract
//    C[i][j] = trunc_ACC( SUM_k A[i][k] * B[k][j] )   signed, exact 2*DATA_W-bit products
//    A x D scales column j of A by d[j];  D x A scales row i of A by d[i]
//
//  Compile-time options
//    +define+TU_DUT_NO_READY   valid-only DUT (no in_ready port)
//    +define+TU_DUT_NO_FLUSH   DUT without flush port (flush tests not applicable)
//  Run-time plusargs  : +SEED=<n> +VERBOSE=<0..3> +NUM_RANDOM=<n> +NUM_STRESS=<n>
//==============================================================================
`timescale 1ns/1ps
`default_nettype none

module tb_tensor_unit #(
  // ---------------------------------------------------------- DUT mirror
  parameter int                N                     = 4,
  parameter int                DATA_W                = 8,
  parameter int                ACC_W                 = 32,
  parameter int                DUT_LATENCY           = 20,
  // ---------------------------------------------------------- environment
  parameter int                EXP_LATENCY           = DUT_LATENCY,  // <0: learn from first completion
  parameter bit                FIXED_LATENCY         = 1'b1,         // 0: variable latency, bounded only
  parameter int                MAX_LATENCY           = 256,
  parameter int                CLK_PERIOD            = 10,
  parameter int                DRIVE_SKEW            = 1,
  parameter int                RESET_CYCLES          = 8,
  parameter int                MIN_RESET_CYCLES      = 2,
  parameter longint unsigned   DEFAULT_SEED          = 64'h7E45_0A11_C0DE_2017,
  parameter int                NUM_RANDOM            = 3000,
  parameter int                NUM_STRESS            = 2000,
  parameter int                NUM_CLASS_REPS        = 4,
  parameter int                NUM_STRUCT_REPS       = 24,
  parameter int                NUM_DETERM            = 400,
  parameter int                RAND_BOUND            = 15,
  parameter int                SWEEP_MAX             = 3,
  parameter int                BUBBLE_PCT            = 20,
  parameter int                FLUSH_PCT             = 3,
  parameter bit                IDLE_SCRAMBLE         = 1'b1,
  parameter bit                COV_ENFORCE           = 1'b1,
  parameter int                MAX_ERR_REPORTS       = 6,
  parameter int                ABORT_ERRORS          = 200,
  parameter longint unsigned   TIMEOUT_CYCLES        = 64'd4_000_000
);

  //============================================================================
  // Derived configuration and types
  //============================================================================
`ifdef TU_DUT_NO_FLUSH
  localparam bit HAS_FLUSH   = 1'b0;
`else
  localparam bit HAS_FLUSH   = 1'b1;
`endif
`ifdef TU_DUT_NO_READY
  localparam bit HAS_READY   = 1'b0;
`else
  localparam bit HAS_READY   = 1'b1;
`endif
  localparam int NUM_MCLS    = 5;
  localparam int NUM_ECLS    = 5;
  localparam int NUM_CTX     = 5;
  localparam int NUM_FCLS    = 4;
  localparam int NUM_GRP     = 10;
  localparam int NUM_CORNERS = 7;
  localparam int IDX_W       = $clog2(N);
  localparam int PROD_W      = 2 * DATA_W;
  localparam int EXACT_W     = PROD_W + $clog2(N) + 1;
  localparam int REF_W       = (EXACT_W > ACC_W + 1) ? EXACT_W : ACC_W + 1;
  localparam int ACC_PAD_W   = ((ACC_W + 63) / 64) * 64;
  localparam int M_PAD_W     = ((N * N * DATA_W + 63) / 64) * 64;
  localparam int OCC_BINS    = MAX_LATENCY + 2;
  localparam int E_COL       = (DATA_W * 30103) / 100000 + 3;
  localparam int C_COL       = (ACC_W * 30103) / 100000 + 3;
  localparam logic [63:0] GOLDEN_GAMMA = 64'h9E37_79B9_7F4A_7C15;

  // issue-context bits recorded per transaction (latency stability coverage)
  localparam int CTX_B2B     = 0;   // accepted the cycle after the previous op
  localparam int CTX_GAP     = 1;   // accepted after one or more idle cycles
  localparam int CTX_RESET   = 2;   // first op after reset
  localparam int CTX_FLUSH   = 3;   // first op after flush
  localparam int CTX_FULL    = 4;   // accepted with the pipeline fully occupied

  // closed-form 4x4 known answers (A1 = 1..16 row-major)
  localparam int KAT_C1 [16] = '{  90,  100,  110,  120,  202,  228,  254,  280,
                                  314,  356,  398,  440,  426,  484,  542,  600};
  localparam int KAT_C2 [16] = '{ -34,   36,  -38,   40,  -66,   68,  -70,   72,
                                  -98,  100, -102,  104, -130,  132, -134,  136};
  localparam int KAT_C3 [16] = '{ -24,  -42,  -60,  -78,  -48,  -54,  -60,  -66,
                                  -72,  -66,  -60,  -54,  -96,  -78,  -60,  -42};

  typedef longint unsigned                          u64_t;
  typedef logic        [DATA_W-1:0]                 elem_t;
  typedef logic        [ACC_W-1:0]                  acc_t;
  typedef logic        [N-1:0][N-1:0][DATA_W-1:0]   mat_t;
  typedef logic        [N-1:0][N-1:0][ACC_W-1:0]    cmat_t;
  typedef logic        [N-1:0][DATA_W-1:0]          dvec_t;
  typedef logic        [N-1:0][IDX_W-1:0]           perm_t;
  typedef logic        [N*N*DATA_W-1:0]             mflat_t;
  typedef logic        [N*N*ACC_W-1:0]              cflat_t;
  typedef logic signed [REF_W-1:0]                  wide_t;
  typedef wide_t                                    wmat_t [N][N];

  localparam elem_t E_MAX = {1'b0, {(DATA_W-1){1'b1}}};
  localparam elem_t E_MIN = {1'b1, {(DATA_W-1){1'b0}}};

  typedef enum logic [2:0] {
    MK_ZERO = 0, MK_IDENT = 1, MK_DIAG = 2, MK_PERM = 3, MK_GEN = 4
  } mcls_e;

  typedef enum logic [2:0] {
    EC_MIN = 0, EC_NEG = 1, EC_ZERO = 2, EC_POS = 3, EC_MAX = 4
  } ecls_e;

  typedef enum logic [1:0] {
    RM_FULL = 0, RM_BOUNDED = 1, RM_SPARSE = 2, RM_CORNER = 3
  } rmode_e;

  typedef enum logic [3:0] {
    G_CLS = 0, G_EA = 1, G_EB = 2, G_PX = 3, G_CSIGN = 4,
    G_GROW = 5, G_OCC = 6, G_LAT = 7, G_FLUSH = 8, G_RST = 9
  } cov_grp_e;

  typedef struct packed {
    int                 id;
    longint unsigned    issue_cyc;
    logic [NUM_CTX-1:0] ctx;
    mat_t               a;
    mat_t               b;
    cmat_t              exp;
  } sb_entry_t;

  //============================================================================
  // DUT interface signals
  //============================================================================
  logic   clk = 1'b0;
  logic   rst_n;
  logic   in_valid;
  logic   in_ready;
  mflat_t in_a;
  mflat_t in_b;
  logic   flush;
  logic   out_valid;
  cflat_t out_c;

  //============================================================================
  // Environment state
  //============================================================================
  longint unsigned cyc = 0;
  longint unsigned master_seed;
  logic [63:0]     stim_state;
  logic [63:0]     junk_state;
  int              verbosity = 1;
  int              num_random;
  int              num_stress;
  bit              env_armed = 1'b0;
  bit              abort_req = 1'b0;
  bit              finished  = 1'b0;
  string           cur_test  = "init";

  sb_entry_t       exp_q[$];
  int              n_driven, n_accepted, n_completed, n_flushed, n_reset_drop;
  int              n_lost, n_spurious, n_errors, n_model_errors, n_stall_cycles;
  int              n_tests, n_flush_pulses, n_closed_checks;
  int              t_err0, t_acc0;
  longint unsigned lat_min = '1, lat_max = 0, lat_sum = 0;
  int              obs_latency = -1;
  int              rst_low_cycles = 0;
  bit              have_prev = 1'b0;
  longint unsigned prev_accept_cyc = 0;
  bit              pend_post_reset = 1'b0;
  bit              pend_post_flush = 1'b0;
  int              max_inflight = 0;
  logic [63:0]     sig_hash = '0;
  longint unsigned sig_epoch_cyc = 0;

  // functional coverage bins
  int              cov_cls      [NUM_MCLS][NUM_MCLS];
  int              cov_ea       [N][N][NUM_ECLS];
  int              cov_eb       [N][N][NUM_ECLS];
  int              cov_px       [NUM_ECLS][NUM_ECLS];
  int              cov_csign    [N][N][3];
  int              cov_grow     [N][N];
  int              cov_occ      [OCC_BINS];
  int              cov_lat      [NUM_CTX];
  int              cov_flush    [NUM_FCLS];
  int              cov_reset_inflight = 0;
  int              grp_bins     [NUM_GRP];
  int              grp_hits     [NUM_GRP];
  int              cov_holes_printed = 0;

  //============================================================================
  // Deterministic PRNG (SplitMix64): simulator-independent stimulus streams.
  // stim_*: test stimulus, reseeded per test.  junk_*: idle-bus scrambling.
  //============================================================================
  function automatic logic [63:0] mix64(input logic [63:0] x);
    logic [63:0] z;
    z = x;
    z = (z ^ (z >> 30)) * 64'hBF58_476D_1CE4_E5B9;
    z = (z ^ (z >> 27)) * 64'h94D0_49BB_1331_11EB;
    return z ^ (z >> 31);
  endfunction

  function automatic logic [63:0] stim_u64();
    stim_state = stim_state + GOLDEN_GAMMA;
    return mix64(stim_state);
  endfunction

  function automatic logic [63:0] junk_u64();
    junk_state = junk_state + GOLDEN_GAMMA;
    return mix64(junk_state);
  endfunction

  function automatic int stim_range(input int n);
    return int'(stim_u64() % 64'(unsigned'(n)));
  endfunction

  function automatic bit stim_pct(input int pct);
    return stim_range(100) < pct;
  endfunction

  //============================================================================
  // Element and matrix utilities
  //============================================================================
  function automatic wide_t sx(input elem_t v);
    return wide_t'({{(REF_W-DATA_W){v[DATA_W-1]}}, v});
  endfunction

  function automatic wide_t sxa(input acc_t v);
    return wide_t'({{(REF_W-ACC_W){v[ACC_W-1]}}, v});
  endfunction

  function automatic bit fits_signed(input wide_t v, input int w);
    wide_t lim;
    lim = wide_t'(1) <<< (w - 1);
    return (v >= -lim) && (v < lim);
  endfunction

  function automatic elem_t corner(input int k);
    case (k % NUM_CORNERS)
      0:       return E_MIN;
      1:       return E_MIN + elem_t'(1);
      2:       return '1;
      3:       return '0;
      4:       return elem_t'(1);
      5:       return E_MAX - elem_t'(1);
      default: return E_MAX;
    endcase
  endfunction

  function automatic elem_t small_elem(input int lim);
    return elem_t'(stim_range(2 * lim + 1)) - elem_t'(lim);
  endfunction

  function automatic elem_t rand_elem(input rmode_e mode);
    int r;
    r = stim_range(100);
    case (mode)
      RM_CORNER:  return corner(stim_range(NUM_CORNERS));
      RM_BOUNDED: return small_elem(RAND_BOUND);
      RM_SPARSE: begin
        if (r < 70) return '0;
        return small_elem(RAND_BOUND);
      end
      default: begin
        if (r < 15) return corner(stim_range(NUM_CORNERS));
        if (r < 40) return small_elem(8);
        return elem_t'(stim_u64());
      end
    endcase
  endfunction

  function automatic rmode_e rand_mode();
    return rmode_e'(stim_range(4));
  endfunction

  function automatic mat_t mat_rand(input rmode_e mode);
    mat_t m;
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        m[i][k] = rand_elem(mode);
    return m;
  endfunction

  function automatic mat_t mat_fill(input elem_t v);
    mat_t m;
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        m[i][k] = v;
    return m;
  endfunction

  function automatic mat_t mat_ident();
    mat_t m;
    m = '0;
    for (int i = 0; i < N; i++) m[i][i] = elem_t'(1);
    return m;
  endfunction

  function automatic mat_t mat_diag(input dvec_t d);
    mat_t m;
    m = '0;
    for (int i = 0; i < N; i++) m[i][i] = d[i];
    return m;
  endfunction

  function automatic mat_t mat_perm(input perm_t p);
    mat_t m;
    m = '0;
    for (int i = 0; i < N; i++) m[i][p[i]] = elem_t'(1);
    return m;
  endfunction

  function automatic mat_t mat_onehot(input int r, input int c, input elem_t v);
    mat_t m;
    m       = '0;
    m[r][c] = v;
    return m;
  endfunction

  function automatic mat_t mat_ramp(input int base, input int step);
    mat_t m;
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        m[i][k] = elem_t'(base + step * (i * N + k));
    return m;
  endfunction

  function automatic dvec_t rand_dvec(input rmode_e mode);
    dvec_t d;
    for (int i = 0; i < N; i++) d[i] = rand_elem(mode);
    return d;
  endfunction

  function automatic perm_t perm_shift(input int s);
    perm_t p;
    for (int i = 0; i < N; i++) p[i] = IDX_W'(unsigned'((i + s) % N));
    return p;
  endfunction

  function automatic perm_t rand_perm();
    perm_t            p;
    logic [IDX_W-1:0] t;
    int               j;
    p = perm_shift(0);
    for (int i = N - 1; i > 0; i--) begin
      j    = stim_range(i + 1);
      t    = p[i];
      p[i] = p[j];
      p[j] = t;
    end
    return p;
  endfunction

  function automatic bit perm_is_ident(input perm_t p);
    for (int i = 0; i < N; i++)
      if (p[i] != IDX_W'(unsigned'(i))) return 1'b0;
    return 1'b1;
  endfunction

  function automatic mcls_e mat_cls(input mat_t m);
    bit nz;
    bit offd;
    bit diag1;
    bit bin01;
    int rc [N];
    int cc [N];
    nz    = 1'b0;
    offd  = 1'b0;
    diag1 = 1'b1;
    bin01 = 1'b1;
    for (int i = 0; i < N; i++) begin
      rc[i] = 0;
      cc[i] = 0;
    end
    for (int i = 0; i < N; i++) begin
      for (int k = 0; k < N; k++) begin
        if (m[i][k] != '0) nz = 1'b1;
        if (i != k && m[i][k] != '0) offd = 1'b1;
        if (i == k && m[i][k] != elem_t'(1)) diag1 = 1'b0;
        if (m[i][k] == elem_t'(1)) begin
          rc[i] += 1;
          cc[k] += 1;
        end else if (m[i][k] != '0) begin
          bin01 = 1'b0;
        end
      end
    end
    if (!nz)          return MK_ZERO;
    if (!offd && diag1) return MK_IDENT;
    if (!offd)        return MK_DIAG;
    if (bin01) begin
      for (int i = 0; i < N; i++)
        if (rc[i] != 1 || cc[i] != 1) return MK_GEN;
      return MK_PERM;
    end
    return MK_GEN;
  endfunction

  // random operand of a requested structural class
  function automatic mat_t mat_of_class(input mcls_e c);
    mat_t  m;
    dvec_t d;
    perm_t p;
    case (c)
      MK_ZERO:  m = '0;
      MK_IDENT: m = mat_ident();
      MK_DIAG: begin
        d = rand_dvec(RM_FULL);
        if (d[0] == '0 || d[0] == elem_t'(1)) d[0] = elem_t'(2);
        m = mat_diag(d);
      end
      MK_PERM: begin
        p = rand_perm();
        if (perm_is_ident(p)) p = perm_shift(1);
        m = mat_perm(p);
      end
      default: begin
        m          = mat_rand(RM_FULL);
        m[0][N-1]  = elem_t'(3);
      end
    endcase
    return m;
  endfunction

  function automatic ecls_e ecls(input elem_t v);
    if (v == E_MIN) return EC_MIN;
    if (v == E_MAX) return EC_MAX;
    if (v == '0)    return EC_ZERO;
    return v[DATA_W-1] ? EC_NEG : EC_POS;
  endfunction

  function automatic logic [1:0] sign_cls(input wide_t v);
    if (v < 0)  return 2'd0;
    if (v == 0) return 2'd1;
    return 2'd2;
  endfunction

  function automatic string mcls_name(input mcls_e c);
    case (c)
      MK_ZERO:  return "ZERO";
      MK_IDENT: return "IDENTITY";
      MK_DIAG:  return "DIAGONAL";
      MK_PERM:  return "PERMUTATION";
      default:  return "GENERAL";
    endcase
  endfunction

  //============================================================================
  // Golden reference model: C = A x B, explicit i/j/k loops, exact signed
  // accumulation in REF_W bits, truncation to ACC_W only at the end.
  //============================================================================
  function automatic wmat_t ref_matmul_exact(input mat_t a, input mat_t b);
    wmat_t c;
    for (int i = 0; i < N; i++) begin
      for (int j = 0; j < N; j++) begin
        c[i][j] = '0;
        for (int k = 0; k < N; k++)
          c[i][j] = c[i][j] + sx(a[i][k]) * sx(b[k][j]);
      end
    end
    return c;
  endfunction

  function automatic cmat_t ref_matmul(input mat_t a, input mat_t b);
    wmat_t x;
    cmat_t c;
    x = ref_matmul_exact(a, b);
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = acc_t'(x[i][j]);
    return c;
  endfunction

  //============================================================================
  // Closed-form expectations for structured operands (independent of the
  // reference accumulation loop; used to validate the golden model itself)
  //============================================================================
  function automatic cmat_t cf_copy(input mat_t a);                  // A x I, I x A
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = acc_t'(sx(a[i][j]));
    return c;
  endfunction

  function automatic cmat_t cf_scale_cols(input mat_t a, input dvec_t d);   // A x D
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = acc_t'(sx(a[i][j]) * sx(d[j]));
    return c;
  endfunction

  function automatic cmat_t cf_scale_rows(input dvec_t d, input mat_t a);   // D x A
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = acc_t'(sx(d[i]) * sx(a[i][j]));
    return c;
  endfunction

  function automatic cmat_t cf_perm_rows(input perm_t p, input mat_t a);    // P x A
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = acc_t'(sx(a[p[i]][j]));
    return c;
  endfunction

  function automatic cmat_t cf_perm_cols(input mat_t a, input perm_t p);    // A x P
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        c[i][p[k]] = acc_t'(sx(a[i][k]));
    return c;
  endfunction

  function automatic cmat_t cf_fill(input elem_t a, input elem_t b);        // fill(a) x fill(b)
    cmat_t c;
    acc_t  v;
    v = acc_t'(wide_t'(N) * sx(a) * sx(b));
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        c[i][j] = v;
    return c;
  endfunction

  function automatic cmat_t cf_outer(input int r, input int c, input elem_t v, input elem_t w,
                                     input bit match);                      // e_rk*v x e_k'c*w
    cmat_t m;
    m       = '0;
    m[r][c] = match ? acc_t'(sx(v) * sx(w)) : '0;
    return m;
  endfunction

  function automatic cmat_t cf_table(input int t);                          // 4x4 known answers
    cmat_t c;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        case (t)
          1:       c[i][j] = acc_t'(wide_t'(KAT_C1[i*N+j]));
          2:       c[i][j] = acc_t'(wide_t'(KAT_C2[i*N+j]));
          default: c[i][j] = acc_t'(wide_t'(KAT_C3[i*N+j]));
        endcase
    return c;
  endfunction

  //============================================================================
  // Logging, formatting, error accounting
  //============================================================================
  function automatic void log_msg(input int lvl, input string msg);
    if (verbosity >= lvl)
      $display("[%0t] [cyc %0d] [%s] %s", $time, cyc, cur_test, msg);
  endfunction

  function automatic void tb_error(input string msg);
    n_errors++;
    if (n_errors <= MAX_ERR_REPORTS)
      $display("[%0t] [cyc %0d] [%s] ERROR: %s", $time, cyc, cur_test, msg);
    else if (n_errors == MAX_ERR_REPORTS + 1)
      $display("[%0t] [cyc %0d] [%s] ERROR: report limit (%0d) reached, further errors counted only",
               $time, cyc, cur_test, MAX_ERR_REPORTS);
    if (n_errors >= ABORT_ERRORS) abort_req = 1'b1;
  endfunction

  // explicit column padding (independent of simulator field-width support)
  function automatic string pad_r(input string s, input int w);
    string r;
    r = s;
    while (r.len() < w) r = {r, " "};
    return r;
  endfunction

  function automatic string pad_l(input string s, input int w);
    string r;
    r = s;
    while (r.len() < w) r = {" ", r};
    return r;
  endfunction

  function automatic void dump_mat(input string name, input mat_t m);
    string line;
    $display("      %s", name);
    for (int i = 0; i < N; i++) begin
      line = "        [";
      for (int k = 0; k < N; k++) line = {line, pad_l($sformatf("%0d", $signed(m[i][k])), E_COL)};
      $display("%s ]", line);
    end
  endfunction

  function automatic void dump_cmat(input string name, input cmat_t m, input cmat_t ref_m);
    string line;
    $display("      %s", name);
    for (int i = 0; i < N; i++) begin
      line = "        [";
      for (int j = 0; j < N; j++)
        line = {line, pad_l($sformatf("%0d", $signed(m[i][j])), C_COL),
                (m[i][j] !== ref_m[i][j]) ? "*" : " "};
      $display("%s ]", line);
    end
  endfunction

  //============================================================================
  // Functional coverage sampling (accepted transactions)
  //============================================================================
  function automatic void cov_sample(input mat_t a, input mat_t b);
    mcls_e      ca;
    mcls_e      cb;
    ecls_e      x;
    ecls_e      y;
    logic [1:0] sg;
    wmat_t      xm;
    ca = mat_cls(a);
    cb = mat_cls(b);
    cov_cls[ca][cb] += 1;
    for (int i = 0; i < N; i++) begin
      for (int k = 0; k < N; k++) begin
        x = ecls(a[i][k]);
        y = ecls(b[i][k]);
        cov_ea[i][k][x] += 1;
        cov_eb[i][k][y] += 1;
      end
    end
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        for (int j = 0; j < N; j++) begin
          x = ecls(a[i][k]);
          y = ecls(b[k][j]);
          cov_px[x][y] += 1;
        end
    xm = ref_matmul_exact(a, b);
    for (int i = 0; i < N; i++) begin
      for (int j = 0; j < N; j++) begin
        sg = sign_cls(xm[i][j]);
        cov_csign[i][j][sg] += 1;
        if (!fits_signed(xm[i][j], PROD_W)) cov_grow[i][j] += 1;
      end
    end
  endfunction

  //============================================================================
  // Scoreboard
  //============================================================================
  function automatic int lat_ref();
    return (EXP_LATENCY >= 0) ? EXP_LATENCY : obs_latency;
  endfunction

  function automatic void sb_accept();
    sb_entry_t e;
    bit        b2b;
    int        lref;
    e.a = mat_t'(in_a);
    e.b = mat_t'(in_b);
    if ($isunknown(e.a) || $isunknown(e.b)) begin
      tb_error("accepted operands contain X/Z");
      return;
    end
    lref             = lat_ref();
    b2b              = have_prev && (cyc == prev_accept_cyc + 1);
    e.ctx            = '0;
    e.ctx[CTX_B2B]   = b2b;
    e.ctx[CTX_GAP]   = have_prev && !b2b;
    e.ctx[CTX_RESET] = pend_post_reset;
    e.ctx[CTX_FLUSH] = pend_post_flush;
    e.ctx[CTX_FULL]  = (lref > 0) && (exp_q.size() >= lref);
    pend_post_reset  = 1'b0;
    pend_post_flush  = 1'b0;
    e.id             = n_accepted;
    e.issue_cyc      = cyc;
    e.exp            = ref_matmul(e.a, e.b);
    cov_sample(e.a, e.b);
    have_prev        = 1'b1;
    prev_accept_cyc  = cyc;
    exp_q.push_back(e);
    n_accepted++;
    if (verbosity >= 2)
      log_msg(2, $sformatf("issue  id=%0d %s x %s in_flight=%0d", e.id, mcls_name(mat_cls(e.a)),
                           mcls_name(mat_cls(e.b)), exp_q.size()));
  endfunction

  function automatic string ctx_str(input logic [NUM_CTX-1:0] c);
    string s;
    s = "";
    if (c[CTX_B2B])   s = {s, "b2b,"};
    if (c[CTX_GAP])   s = {s, "gap,"};
    if (c[CTX_RESET]) s = {s, "post-reset,"};
    if (c[CTX_FLUSH]) s = {s, "post-flush,"};
    if (c[CTX_FULL])  s = {s, "pipe-full,"};
    if (s.len() == 0) return "first";
    return s.substr(0, s.len() - 2);
  endfunction

  function automatic bit latency_check(input int id, input logic [NUM_CTX-1:0] ctx,
                                       input longint unsigned lat);
    string why;
    if (lat < lat_min) lat_min = lat;
    if (lat > lat_max) lat_max = lat;
    lat_sum += lat;
    if (obs_latency < 0) begin
      obs_latency = int'(lat);
      if (EXP_LATENCY < 0) log_msg(1, $sformatf("learned DUT latency = %0d cycles", obs_latency));
    end
    if (!FIXED_LATENCY) return 1'b1;
    if (lat != u64_t'(lat_ref())) begin
      if (lat > u64_t'(lat_ref()))
        why = "late: extra stage or internal stall";
      else if (ctx[CTX_FLUSH] || ctx[CTX_RESET])
        why = "early: stale result leaked past flush/reset";
      else
        why = "early: missing stage or result skipped ahead";
      tb_error($sformatf("PIPELINE MISALIGNMENT id=%0d ctx=%s: result after %0d cycles, %s latency %0d (%s)",
                         id, ctx_str(ctx), lat, (EXP_LATENCY >= 0) ? "expected" : "learned",
                         lat_ref(), why));
      return 1'b0;
    end
    return 1'b1;
  endfunction

  function automatic void report_mismatch(input sb_entry_t e, input cmat_t act, input longint unsigned lat);
    int    nbad;
    wide_t term;
    wide_t diff;
    string tl;
    string hint;
    string xz_note;
    nbad = 0;
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++)
        if (act[i][j] !== e.exp[i][j]) nbad++;
    if ($isunknown(act)) xz_note = " [X/Z on result]";
    else                 xz_note = "";
    tb_error($sformatf({"MISMATCH id=%0d issue_cyc=%0d done_cyc=%0d latency=%0d ctx=%s %s x %s: ",
                        "%0d of %0d elements wrong%s"},
                       e.id, e.issue_cyc, cyc, lat, ctx_str(e.ctx), mcls_name(mat_cls(e.a)),
                       mcls_name(mat_cls(e.b)), nbad, N * N, xz_note));
    if (n_errors > MAX_ERR_REPORTS) return;
    dump_mat("A", e.a);
    dump_mat("B", e.b);
    dump_cmat("expected C", e.exp, e.exp);
    dump_cmat("actual C   (* = mismatch)", act, e.exp);
    for (int i = 0; i < N; i++) begin
      for (int j = 0; j < N; j++) begin
        if (act[i][j] !== e.exp[i][j]) begin
          tl   = "";
          hint = "";
          diff = sxa(act[i][j]) - sxa(e.exp[i][j]);
          for (int k = 0; k < N; k++) begin
            term = sx(e.a[i][k]) * sx(e.b[k][j]);
            if (k != 0) tl = {tl, " + "};
            tl   = {tl, $sformatf("(%0d*%0d)", $signed(e.a[i][k]), $signed(e.b[k][j]))};
            if (term != 0 && diff == -term)
              hint = {hint, $sformatf(" [diff = -term k=%0d: dropped term?]", k)};
            if (term != 0 && diff == term)
              hint = {hint, $sformatf(" [diff = +term k=%0d: repeated term?]", k)};
          end
          $display("      C[%0d][%0d] exp=%0d act=%0d diff=%0d xor=0x%h | %s%s",
                   i, j, $signed(e.exp[i][j]), $signed(act[i][j]), diff,
                   e.exp[i][j] ^ act[i][j], tl, hint);
        end
      end
    end
  endfunction

  function automatic void sb_check(input cmat_t act);
    sb_entry_t            e;
    longint unsigned      lat;
    bit                   lat_ok;
    logic [ACC_PAD_W-1:0] pv;
    if (exp_q.size() == 0) begin
      n_spurious++;
      tb_error("SPURIOUS out_valid with no transaction in flight");
      if (n_errors <= MAX_ERR_REPORTS) dump_cmat("unexpected C", act, act);
      return;
    end
    e      = exp_q.pop_front();
    lat    = cyc - e.issue_cyc;
    n_completed++;
    lat_ok = latency_check(e.id, e.ctx, lat);
    if (act !== e.exp) begin
      report_mismatch(e, act, lat);
    end else begin
      if (lat_ok)
        for (int c = 0; c < NUM_CTX; c++)
          if (e.ctx[c]) cov_lat[c] += 1;
      if (verbosity >= 3) log_msg(3, $sformatf("pass   id=%0d latency=%0d", e.id, lat));
    end
    // determinism signature: relative completion time + full result payload
    sig_hash = mix64(sig_hash ^ (cyc - sig_epoch_cyc));
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++) begin
        pv = ACC_PAD_W'(act[i][j]);
        for (int k = 0; k < ACC_PAD_W; k += 64) sig_hash = mix64(sig_hash ^ pv[k +: 64]);
      end
  endfunction

  function automatic void sb_flush(input bit delivered);
    int         depth;
    int         lref;
    logic [1:0] fc;
    depth = exp_q.size();
    lref  = lat_ref();
    n_flush_pulses++;
    if (depth == 0)                                      fc = 2'd0;
    else if (depth >= ((lref > 2) ? lref - 1 : 1))       fc = 2'd2;
    else                                                 fc = 2'd1;
    cov_flush[fc] += 1;
    if (delivered) cov_flush[3] += 1;
    n_flushed       += depth;
    pend_post_flush  = 1'b1;
    exp_q.delete();
    log_msg(2, $sformatf("flush  dropped=%0d delivered_at_edge=%0d", depth, delivered));
  endfunction

  //============================================================================
  // DUT
  //============================================================================
`ifdef TU_DUT_NO_READY
  assign in_ready = 1'b1;
`endif

  tensor_unit #(
    .N        (N),
    .DATA_W   (DATA_W),
    .ACC_W    (ACC_W),
    .LATENCY  (DUT_LATENCY)
  ) u_dut (
    .clk       (clk),
    .rst_n     (rst_n),
    .in_valid  (in_valid),
`ifndef TU_DUT_NO_READY
    .in_ready  (in_ready),
`endif
    .in_a      (in_a),
    .in_b      (in_b),
`ifndef TU_DUT_NO_FLUSH
    .flush     (flush),
`endif
    .out_valid (out_valid),
    .out_c     (out_c)
  );

  //============================================================================
  // Clock and monitor (sole owner of the cycle counter)
  //============================================================================
  initial forever #(CLK_PERIOD / 2) clk = ~clk;

  // One sampling process per active edge, strictly ordered:
  //   1. acceptance  (zero-latency DUTs align within the same edge)
  //   2. completion  (a result presented at a flush edge is delivered)
  //   3. flush       (everything still in flight is discarded)
  initial forever begin : p_monitor
    bit delivered;
    int depth;
    @(posedge clk);
    cyc++;
    delivered = 1'b0;
    if (rst_n !== 1'b1) begin
      rst_low_cycles++;
      if (exp_q.size() != 0) begin
        n_reset_drop += exp_q.size();
        cov_reset_inflight++;
        exp_q.delete();
      end
      have_prev       = 1'b0;
      pend_post_reset = 1'b1;
      pend_post_flush = 1'b0;
      if (rst_low_cycles >= 2 && out_valid !== 1'b0)
        tb_error($sformatf("out_valid=%b while reset held for %0d cycles", out_valid, rst_low_cycles));
    end else if (env_armed && !finished) begin
      rst_low_cycles = 0;
      if ($isunknown(in_ready) || $isunknown(out_valid))
        tb_error($sformatf("X/Z on handshake after reset: in_ready=%b out_valid=%b", in_ready, out_valid));
      if (in_valid === 1'b1 && flush === 1'b1)
        tb_error("environment protocol violation: in_valid asserted in a flush cycle");
      if (in_valid === 1'b1 && in_ready !== 1'b1) n_stall_cycles++;
      if (in_valid === 1'b1 && in_ready === 1'b1) sb_accept();
      if (out_valid === 1'b1) begin
        sb_check(cmat_t'(out_c));
        delivered = 1'b1;
      end
      if (HAS_FLUSH && flush === 1'b1) sb_flush(delivered);
      depth = exp_q.size();
      if (depth > max_inflight) max_inflight = depth;
      if (depth >= OCC_BINS) depth = OCC_BINS - 1;
      cov_occ[depth] += 1;
      if (exp_q.size() != 0 && (cyc - exp_q[0].issue_cyc) > u64_t'(MAX_LATENCY)) begin
        n_lost++;
        tb_error($sformatf("LOST TRANSACTION id=%0d issued at cyc %0d: no result within %0d cycles",
                           exp_q[0].id, exp_q[0].issue_cyc, MAX_LATENCY));
        void'(exp_q.pop_front());
      end
    end
    if (!finished && cyc >= TIMEOUT_CYCLES) begin
      tb_error($sformatf("GLOBAL TIMEOUT after %0d cycles", cyc));
      finish_test();
    end else if (!finished && abort_req) begin
      $display("[%0t] [cyc %0d] aborting: error budget (%0d) exhausted", $time, cyc, ABORT_ERRORS);
      finish_test();
    end
  end

  //============================================================================
  // Driver - inputs change DRIVE_SKEW after the active edge and are sampled
  // at the edge, so no drive ever coincides with a sampling event in any
  // simulator scheduler.  Every driver task returns at edge + DRIVE_SKEW.
  //============================================================================
  task automatic scramble_idle_bus();
    logic [M_PAD_W-1:0] ja;
    logic [M_PAD_W-1:0] jb;
    if (IDLE_SCRAMBLE) begin
      for (int k = 0; k < M_PAD_W; k += 64) begin
        ja[k +: 64] = junk_u64();
        jb[k +: 64] = junk_u64();
      end
      in_a = mflat_t'(ja);
      in_b = mflat_t'(jb);
    end
  endtask

  task automatic next_cycle();
    @(posedge clk);
    #(DRIVE_SKEW);
  endtask

  task automatic drive_txn(input mat_t a, input mat_t b);
    in_valid = 1'b1;
    in_a     = mflat_t'(a);
    in_b     = mflat_t'(b);
    do @(posedge clk); while (in_ready !== 1'b1);
    #(DRIVE_SKEW);
    in_valid = 1'b0;
    n_driven++;
  endtask

  task automatic idle(input int n);
    in_valid = 1'b0;
    repeat (n) begin
      scramble_idle_bus();
      next_cycle();
    end
  endtask

  task automatic drain();
    int guard;
    guard = 0;
    while (exp_q.size() != 0 && guard <= MAX_LATENCY + 4) begin
      idle(1);
      guard++;
    end
    if (exp_q.size() != 0)
      tb_error($sformatf("drain timeout: %0d transactions still in flight", exp_q.size()));
    idle(2);
  endtask

  task automatic apply_reset(input int n_cycles);
    rst_n    = 1'b0;
    in_valid = 1'b0;
    flush    = 1'b0;
    repeat (n_cycles) begin
      scramble_idle_bus();
      next_cycle();
    end
    rst_n     = 1'b1;
    env_armed = 1'b1;
    next_cycle();
  endtask

  task automatic pulse_flush();
    in_valid = 1'b0;
    flush    = 1'b1;
    scramble_idle_bus();
    next_cycle();
    flush    = 1'b0;
  endtask

  //============================================================================
  // Stimulus helpers
  //============================================================================
  // closed-form expectation is checked against the golden model before issue;
  // the scoreboard then checks the DUT against the golden model
  task automatic issue_closed(input string name, input mat_t a, input mat_t b, input cmat_t cexp);
    cmat_t m;
    m = ref_matmul(a, b);
    n_closed_checks++;
    if (m !== cexp) begin
      n_model_errors++;
      tb_error($sformatf("REFERENCE MODEL disagrees with closed form '%s'", name));
      if (n_errors <= MAX_ERR_REPORTS) begin
        dump_mat("A", a);
        dump_mat("B", b);
        dump_cmat("closed-form C", cexp, cexp);
        dump_cmat("model C    (* = mismatch)", m, cexp);
      end
    end
    log_msg(3, $sformatf("closed-form %s", name));
    drive_txn(a, b);
  endtask

  task automatic issue_random(input int bubble_pct, input int struct_pct);
    mat_t   a;
    mat_t   b;
    rmode_e mode;
    if (stim_pct(bubble_pct)) idle(1 + stim_range(3));
    mode = rand_mode();
    a    = stim_pct(struct_pct) ? mat_of_class(mcls_e'(stim_range(NUM_MCLS))) : mat_rand(mode);
    b    = stim_pct(struct_pct) ? mat_of_class(mcls_e'(stim_range(NUM_MCLS))) : mat_rand(mode);
    drive_txn(a, b);
  endtask

  //============================================================================
  // Test infrastructure
  //============================================================================
  task automatic test_begin(input string name);
    n_tests++;
    cur_test   = name;
    stim_state = mix64(master_seed ^ (64'(unsigned'(n_tests)) * GOLDEN_GAMMA));
    t_err0     = n_errors;
    t_acc0     = n_accepted;
    log_msg(1, "begin");
  endtask

  task automatic test_end();
    drain();
    log_msg(1, $sformatf("end    : %0d transactions, %0d new errors",
                         n_accepted - t_acc0, n_errors - t_err0));
  endtask

  //----------------------------------------------------------------------------
  // T0: post-reset quiescence and input liveness
  //----------------------------------------------------------------------------
  task automatic test_reset_quiescence();
    int waited;
    test_begin("reset_quiescence");
    idle(16 + 2 * ((EXP_LATENCY > 0) ? EXP_LATENCY : 8));
    waited = 0;
    while (in_ready !== 1'b1 && waited < MAX_LATENCY) begin
      idle(1);
      waited++;
    end
    if (in_ready !== 1'b1)
      tb_error($sformatf("in_ready not asserted within %0d idle cycles after reset", MAX_LATENCY));
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T1: fixed known answers (validates golden model and DUT)
  //----------------------------------------------------------------------------
  task automatic test_known_answer();
    mat_t  a;
    mat_t  b;
    dvec_t d;
    perm_t p;
    cmat_t c;
    test_begin("known_answer");
    if (N == 4 && DATA_W >= 8) begin
      a = mat_ramp(1, 1);
      issue_closed("A1 x A1 (1..16 squared)", a, a, cf_table(1));
      for (int k = 0; k < N; k++)
        for (int j = 0; j < N; j++)
          b[k][j] = elem_t'((((k + j) % 2) == 0 ? 1 : -1) * (k * N + j + 1));
      issue_closed("A1 x alternating-sign A1", a, b, cf_table(2));
      for (int i = 0; i < N; i++)
        for (int k = 0; k < N; k++)
          a[i][k] = elem_t'((i - k) * 3);
      issue_closed("skew x offset ramp", a, mat_ramp(-8, 1), cf_table(3));
    end
    issue_closed("I x I", mat_ident(), mat_ident(), cf_copy(mat_ident()));
    a = mat_ramp(-(N * N) / 2, 1);
    issue_closed("ramp x I", a, mat_ident(), cf_copy(a));
    issue_closed("I x ramp", mat_ident(), a, cf_copy(a));
    issue_closed("ramp x 0", a, '0, '0);
    issue_closed("0 x ramp", '0, a, '0);
    issue_closed("MIN x MIN (accumulator growth)", mat_fill(E_MIN), mat_fill(E_MIN), cf_fill(E_MIN, E_MIN));
    issue_closed("MAX x MIN", mat_fill(E_MAX), mat_fill(E_MIN), cf_fill(E_MAX, E_MIN));
    issue_closed("MAX x MAX", mat_fill(E_MAX), mat_fill(E_MAX), cf_fill(E_MAX, E_MAX));
    issue_closed("-1 x -1", mat_fill('1), mat_fill('1), cf_fill('1, '1));
    for (int i = 0; i < N; i++) d[i] = (i == 0) ? E_MIN : elem_t'(2 * i - 3);
    issue_closed("ramp x D", a, mat_diag(d), cf_scale_cols(a, d));
    issue_closed("D x ramp", mat_diag(d), a, cf_scale_rows(d, a));
    p = perm_shift(1);
    issue_closed("P1 x ramp", mat_perm(p), a, cf_perm_rows(p, a));
    issue_closed("ramp x P1", a, mat_perm(p), cf_perm_cols(a, p));
    c = cf_scale_cols(mat_diag(d), d);
    issue_closed("D x D", mat_diag(d), mat_diag(d), c);
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T2: identity  A x I = A, I x A = A
  //----------------------------------------------------------------------------
  task automatic test_identity();
    mat_t a;
    test_begin("identity");
    for (int r = 0; r < NUM_STRUCT_REPS; r++) begin
      a = mat_rand(rmode_e'(r % 4));
      issue_closed("A x I", a, mat_ident(), cf_copy(a));
      issue_closed("I x A", mat_ident(), a, cf_copy(a));
    end
    for (int k = 0; k < NUM_CORNERS; k++) begin
      a = mat_fill(corner(k));
      issue_closed("corner x I", a, mat_ident(), cf_copy(a));
      issue_closed("I x corner", mat_ident(), a, cf_copy(a));
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T3: diagonal  A x D (column scaling), D x A (row scaling), D x D
  //----------------------------------------------------------------------------
  task automatic test_diagonal();
    mat_t  a;
    dvec_t d;
    dvec_t e;
    test_begin("diagonal");
    for (int r = 0; r < NUM_STRUCT_REPS; r++) begin
      a = mat_rand(rmode_e'(r % 4));
      d = rand_dvec(rmode_e'((r / 4) % 4));
      issue_closed("A x D", a, mat_diag(d), cf_scale_cols(a, d));
      issue_closed("D x A", mat_diag(d), a, cf_scale_rows(d, a));
      e = rand_dvec(RM_FULL);
      issue_closed("D x E", mat_diag(d), mat_diag(e), cf_scale_cols(mat_diag(d), e));
    end
    for (int k = 0; k < NUM_CORNERS; k++) begin
      a = mat_rand(RM_FULL);
      for (int i = 0; i < N; i++) d[i] = corner(k + i);
      issue_closed("A x corner D", a, mat_diag(d), cf_scale_cols(a, d));
      issue_closed("corner D x A", mat_diag(d), a, cf_scale_rows(d, a));
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T4: zero  A x 0 = 0, 0 x A = 0
  //----------------------------------------------------------------------------
  task automatic test_zero();
    mat_t a;
    test_begin("zero");
    issue_closed("0 x 0", '0, '0, '0);
    for (int r = 0; r < NUM_STRUCT_REPS; r++) begin
      a = mat_rand(rmode_e'(r % 4));
      issue_closed("A x 0", a, '0, '0);
      issue_closed("0 x A", '0, a, '0);
    end
    issue_closed("MIN x 0", mat_fill(E_MIN), '0, '0);
    issue_closed("0 x MIN", '0, mat_fill(E_MIN), '0);
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T5: permutation  P x A permutes rows, A x P permutes columns
  //     (operand-order and routing sensitive; identity cannot expose A<->B swaps)
  //----------------------------------------------------------------------------
  task automatic test_permutation();
    mat_t  a;
    perm_t p;
    test_begin("permutation");
    for (int s = 0; s < N; s++) begin
      a = mat_rand(RM_FULL);
      p = perm_shift(s);
      issue_closed("Pshift x A", mat_perm(p), a, cf_perm_rows(p, a));
      issue_closed("A x Pshift", a, mat_perm(p), cf_perm_cols(a, p));
    end
    for (int r = 0; r < NUM_STRUCT_REPS; r++) begin
      a = mat_rand(rmode_e'(r % 4));
      p = rand_perm();
      issue_closed("P x A", mat_perm(p), a, cf_perm_rows(p, a));
      issue_closed("A x P", a, mat_perm(p), cf_perm_cols(a, p));
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T6: small signed value sweep and single-term outer-product walk
  //     (isolates every A[i][k]*B[k][j] MAC path)
  //----------------------------------------------------------------------------
  task automatic test_value_sweep();
    elem_t v;
    elem_t w;
    test_begin("value_sweep");
    for (int x = -SWEEP_MAX; x <= SWEEP_MAX; x++)
      for (int y = -SWEEP_MAX; y <= SWEEP_MAX; y++)
        issue_closed("fill sweep", mat_fill(elem_t'(x)), mat_fill(elem_t'(y)),
                     cf_fill(elem_t'(x), elem_t'(y)));
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        for (int j = 0; j < N; j++) begin
          v = corner(i + 2 * k + j);
          w = corner(3 * i + k + 2 * j + 1);
          if (v == '0) v = E_MIN;
          if (w == '0) w = E_MAX;
          issue_closed("outer e_ik x e_kj", mat_onehot(i, k, v), mat_onehot(k, j, w),
                       cf_outer(i, j, v, w, 1'b1));
          issue_closed("outer e_ik x e_k'j", mat_onehot(i, k, v), mat_onehot((k + 1) % N, j, w),
                       cf_outer(i, j, v, w, 1'b0));
        end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T7: boundary operands (all corner pairs, then per-element corner mixes)
  //----------------------------------------------------------------------------
  task automatic test_boundary();
    mat_t a;
    mat_t b;
    test_begin("boundary");
    for (int x = 0; x < NUM_CORNERS; x++)
      for (int y = 0; y < NUM_CORNERS; y++)
        issue_closed("corner fill pair", mat_fill(corner(x)), mat_fill(corner(y)),
                     cf_fill(corner(x), corner(y)));
    for (int r = 0; r < NUM_CORNERS; r++) begin
      for (int i = 0; i < N; i++)
        for (int k = 0; k < N; k++) begin
          a[i][k] = corner(i * N + k + r);
          b[i][k] = corner(3 * (i * N + k) + r + 1);
        end
      drive_txn(a, b);
      drive_txn(b, a);
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T8: full operand-class cross (ZERO/IDENTITY/DIAGONAL/PERMUTATION/GENERAL)^2
  //----------------------------------------------------------------------------
  task automatic test_class_cross();
    mat_t a;
    mat_t b;
    test_begin("class_cross");
    for (int ca = 0; ca < NUM_MCLS; ca++)
      for (int cb = 0; cb < NUM_MCLS; cb++)
        for (int r = 0; r < NUM_CLASS_REPS; r++) begin
          a = mat_of_class(mcls_e'(ca));
          b = mat_of_class(mcls_e'(cb));
          if (mat_cls(a) != mcls_e'(ca) || mat_cls(b) != mcls_e'(cb))
            tb_error($sformatf("stimulus generator produced %s x %s for requested %s x %s",
                               mcls_name(mat_cls(a)), mcls_name(mat_cls(b)),
                               mcls_name(mcls_e'(ca)), mcls_name(mcls_e'(cb))));
          drive_txn(a, b);
        end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T9: constrained-random streaming with bubbles
  //----------------------------------------------------------------------------
  task automatic test_random_stream();
    test_begin("random_stream");
    for (int n = 0; n < num_random; n++) issue_random(BUBBLE_PCT, 15);
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T10: pipeline saturation - continuous back-to-back issue, many in flight
  //----------------------------------------------------------------------------
  task automatic test_pipeline_saturation();
    test_begin("pipeline_saturation");
    for (int n = 0; n < num_stress; n++) issue_random(0, 10);
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T11: occupancy sweep - fixed issue spacing 0..L+1 visits every depth
  //----------------------------------------------------------------------------
  task automatic test_occupancy_sweep();
    int lref;
    int gmax;
    test_begin("occupancy_sweep");
    lref = (lat_ref() > 0) ? lat_ref() : 2;
    gmax = (lref + 1 > 32) ? 32 : lref + 1;
    for (int gap = 0; gap <= gmax; gap++) begin
      for (int n = 0; n < 2 * lref + 4; n++) begin
        drive_txn(mat_rand(rand_mode()), mat_rand(rand_mode()));
        if (gap != 0) idle(gap);
      end
      drain();
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T12: flush - empty, single-op boundary sweep, saturated, partial depths,
  //      back-to-back pulses, issue immediately after flush, random interleave
  //----------------------------------------------------------------------------
  task automatic test_flush();
    int lref;
    int step;
    test_begin("flush");
    if (!HAS_FLUSH) begin
      log_msg(1, "DUT has no flush port: test not applicable");
      test_end();
      return;
    end
    lref = (lat_ref() > 0) ? lat_ref() : 1;
    pulse_flush();
    idle(2);
    for (int g = 0; g <= lref + 1; g++) begin
      drive_txn(mat_rand(RM_FULL), mat_rand(RM_FULL));
      if (g != 0) idle(g);
      pulse_flush();
      drain();
    end
    for (int rep = 0; rep < 3; rep++) begin
      for (int n = 0; n < lref + 4; n++) issue_random(0, 10);
      pulse_flush();
      for (int n = 0; n < 2 * lref; n++) issue_random(0, 10);
      drain();
    end
    step = (lref / 6 > 0) ? lref / 6 : 1;
    for (int k = 1; k < lref; k += step) begin
      for (int n = 0; n < k; n++) issue_random(0, 10);
      pulse_flush();
      issue_random(0, 10);
      issue_random(0, 10);
      drain();
    end
    for (int n = 0; n < lref / 2 + 1; n++) issue_random(0, 10);
    pulse_flush();
    pulse_flush();
    for (int n = 0; n < lref; n++) issue_random(0, 10);
    drain();
    for (int n = 0; n < 40 * lref; n++) begin
      if (stim_pct(FLUSH_PCT)) pulse_flush();
      issue_random(BUBBLE_PCT, 10);
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T13: reset with operations in flight; pipeline must restart clean
  //----------------------------------------------------------------------------
  task automatic test_reset_in_flight();
    int depth;
    test_begin("reset_in_flight");
    for (int rep = 0; rep < 4; rep++) begin
      depth = ((lat_ref() > 0) ? lat_ref() : 1) * (rep + 1) / 4 + 1;
      for (int n = 0; n < depth; n++) issue_random(0, 10);
      apply_reset(MIN_RESET_CYCLES + 3 * rep);
      for (int n = 0; n < 2 * ((lat_ref() > 0) ? lat_ref() : 4); n++) issue_random(0, 10);
      drain();
    end
    test_end();
  endtask

  //----------------------------------------------------------------------------
  // T14: determinism - identical post-reset stream gives identical results
  //      and identical completion timing
  //----------------------------------------------------------------------------
  task automatic test_determinism();
    logic [63:0] sig [2];
    int          cnt [2];
    int          c0;
    test_begin("determinism");
    for (int pass = 0; pass < 2; pass++) begin
      apply_reset(RESET_CYCLES);
      stim_state    = mix64(master_seed ^ 64'hD37E_2A11_7E45_0001);
      junk_state    = mix64(master_seed ^ 64'hD37E_2A11_7E45_0002);
      sig_hash      = '0;
      sig_epoch_cyc = cyc;
      c0            = n_completed;
      for (int n = 0; n < NUM_DETERM; n++) issue_random(BUBBLE_PCT, 15);
      drain();
      sig[pass] = sig_hash;
      cnt[pass] = n_completed - c0;
      log_msg(1, $sformatf("pass %0d: %0d results, signature 0x%h", pass, cnt[pass], sig[pass]));
    end
    if (sig[0] !== sig[1] || cnt[0] != cnt[1])
      tb_error($sformatf("NON-DETERMINISTIC DUT: signature 0x%h/%0d vs 0x%h/%0d for identical stimulus",
                         sig[0], cnt[0], sig[1], cnt[1]));
    test_end();
  endtask

  //============================================================================
  // Coverage closure and final report
  //============================================================================
  function automatic void cov_bin(input cov_grp_e g, input int hits, input string what);
    grp_bins[g]++;
    if (hits != 0) begin
      grp_hits[g]++;
    end else if (cov_holes_printed < 24) begin
      cov_holes_printed++;
      $display("  coverage hole: %s", what);
    end
  endfunction

  function automatic string grp_name(input cov_grp_e g);
    case (g)
      G_CLS:   return "operand class A x B";
      G_EA:    return "A element value class";
      G_EB:    return "B element value class";
      G_PX:    return "MAC product sign cross";
      G_CSIGN: return "C element sign";
      G_GROW:  return "C accumulator growth";
      G_OCC:   return "pipeline occupancy depth";
      G_LAT:   return "latency stability context";
      G_FLUSH: return "flush scenario";
      default: return "reset with ops in flight";
    endcase
  endfunction

  function automatic bit report_coverage(input int lat_eff);
    int    tb_bins;
    int    tb_hits;
    int    g_hit;
    int    g_bin;
    string gname;
    string ctx_name [NUM_CTX];
    string fl_name  [NUM_FCLS];
    ctx_name = '{"back-to-back", "after gap", "after reset", "after flush", "pipeline full"};
    fl_name  = '{"empty pipe", "partial depth", "full depth", "result at flush edge"};
    tb_bins  = 0;
    tb_hits  = 0;
    for (int x = 0; x < NUM_MCLS; x++)
      for (int y = 0; y < NUM_MCLS; y++)
        cov_bin(G_CLS, cov_cls[x][y], $sformatf("%s x %s", mcls_name(mcls_e'(x)), mcls_name(mcls_e'(y))));
    for (int i = 0; i < N; i++)
      for (int k = 0; k < N; k++)
        for (int c = 0; c < NUM_ECLS; c++) begin
          cov_bin(G_EA, cov_ea[i][k][c], $sformatf("A[%0d][%0d] class %0d", i, k, c));
          cov_bin(G_EB, cov_eb[i][k][c], $sformatf("B[%0d][%0d] class %0d", i, k, c));
        end
    for (int x = 0; x < NUM_ECLS; x++)
      for (int y = 0; y < NUM_ECLS; y++)
        cov_bin(G_PX, cov_px[x][y], $sformatf("product A class %0d x B class %0d", x, y));
    for (int i = 0; i < N; i++)
      for (int j = 0; j < N; j++) begin
        for (int s = 0; s < 3; s++)
          cov_bin(G_CSIGN, cov_csign[i][j][s], $sformatf("C[%0d][%0d] sign bin %0d", i, j, s));
        cov_bin(G_GROW, cov_grow[i][j], $sformatf("C[%0d][%0d] beyond product range", i, j));
      end
    for (int d = 0; d <= lat_eff && d < OCC_BINS; d++)
      cov_bin(G_OCC, cov_occ[d], $sformatf("in-flight depth %0d", d));
    for (int c = 0; c < NUM_CTX; c++) begin
      if (c == CTX_FLUSH && !HAS_FLUSH) continue;
      if (c == CTX_FULL && lat_eff == 0) continue;
      cov_bin(G_LAT, cov_lat[c], $sformatf("correct latency %s", ctx_name[c]));
    end
    if (HAS_FLUSH && lat_eff >= 2)
      for (int f = 0; f < NUM_FCLS; f++)
        cov_bin(G_FLUSH, cov_flush[f], $sformatf("flush %s", fl_name[f]));
    if (lat_eff > 0)
      cov_bin(G_RST, cov_reset_inflight, "reset with operations in flight");
    $display("  %s %s %s %s", pad_r("coverage group", 28), pad_l("hit", 8), pad_l("bins", 8),
             pad_l("percent", 9));
    for (int g = 0; g < NUM_GRP; g++) begin
      if (grp_bins[g] != 0) begin
        gname = grp_name(cov_grp_e'(g));
        g_hit = grp_hits[g];
        g_bin = grp_bins[g];
        $display("  %s %s %s %s%%", pad_r(gname, 28), pad_l($sformatf("%0d", g_hit), 8),
                 pad_l($sformatf("%0d", g_bin), 8),
                 pad_l($sformatf("%0.2f", 100.0 * real'(g_hit) / real'(g_bin)), 8));
        tb_bins += g_bin;
        tb_hits += g_hit;
      end
    end
    $display("  %s %s %s %s%%", pad_r("TOTAL", 28), pad_l($sformatf("%0d", tb_hits), 8),
             pad_l($sformatf("%0d", tb_bins), 8),
             pad_l($sformatf("%0.2f", 100.0 * real'(tb_hits) / real'(tb_bins)), 8));
    return tb_hits == tb_bins;
  endfunction

  task automatic finish_test();
    int lat_eff;
    bit cov_closed;
    bit acct_ok;
    if (finished) return;
    finished = 1'b1;
    cur_test = "report";
    lat_eff  = (lat_ref() > 0) ? lat_ref() : 0;
    if (lat_eff > MAX_LATENCY) lat_eff = MAX_LATENCY;
    $display("==========================================================================");
    $display(" tb_tensor_unit  N=%0d DATA_W=%0d ACC_W=%0d LATENCY=%0d READY=%0d FLUSH=%0d",
             N, DATA_W, ACC_W, lat_eff, HAS_READY, HAS_FLUSH);
    $display("--------------------------------------------------------------------------");
    cov_closed = report_coverage(lat_eff);
    acct_ok    = (n_driven == n_accepted) &&
                 (n_accepted == n_completed + n_flushed + n_reset_drop + n_lost + exp_q.size());
    if (!acct_ok)
      tb_error($sformatf({"transaction accounting broken: driven=%0d accepted=%0d completed=%0d ",
                          "flushed=%0d reset_dropped=%0d lost=%0d pending=%0d"},
                         n_driven, n_accepted, n_completed, n_flushed, n_reset_drop, n_lost, exp_q.size()));
    if (n_completed == 0)
      tb_error("no transaction completed");
    if (COV_ENFORCE && !cov_closed)
      tb_error("functional coverage closure not reached");
    $display("--------------------------------------------------------------------------");
    $display("  seed                  : %0d  (reproduce with +SEED=%0d)", master_seed, master_seed);
    $display("  tests run             : %0d", n_tests);
    $display("  driven / accepted     : %0d / %0d", n_driven, n_accepted);
    $display("  checked               : %0d", n_completed);
    $display("  flushed / reset-drop  : %0d / %0d  (%0d flush pulses)",
             n_flushed, n_reset_drop, n_flush_pulses);
    $display("  lost / spurious       : %0d / %0d", n_lost, n_spurious);
    $display("  closed-form checks    : %0d (golden model disagreements: %0d)",
             n_closed_checks, n_model_errors);
    $display("  input stall cycles    : %0d", n_stall_cycles);
    $display("  latency min/max/avg   : %0d / %0d / %0.2f", (n_completed != 0) ? lat_min : 0, lat_max,
             (n_completed != 0) ? real'(lat_sum) / real'(n_completed) : 0.0);
    $display("  peak in-flight        : %0d", max_inflight);
    $display("  errors                : %0d", n_errors);
    $display("  simulated cycles      : %0d", cyc);
    $display("==========================================================================");
    if (n_errors == 0) begin
      $display("*** TEST PASSED ***");
      $finish;
    end else begin
      $fatal(1, "*** TEST FAILED *** (%0d errors)", n_errors);
    end
  endtask

  //============================================================================
  // Configuration checks and main sequence
  //============================================================================
  task automatic init_env();
    if (N < 2 || N > 16)              $fatal(1, "N=%0d outside supported range 2..16", N);
    if (DATA_W < 5 || DATA_W > 32)    $fatal(1, "DATA_W=%0d outside supported range 5..32", DATA_W);
    if (ACC_W < DATA_W || ACC_W > 128) $fatal(1, "ACC_W=%0d outside supported range DATA_W..128", ACC_W);
    if (RAND_BOUND < 1 || RAND_BOUND > (1 << (DATA_W - 1)) - 1)
      $fatal(1, "RAND_BOUND=%0d not representable in DATA_W=%0d", RAND_BOUND, DATA_W);
    if (SWEEP_MAX < 1 || SWEEP_MAX > (1 << (DATA_W - 1)) - 1)
      $fatal(1, "SWEEP_MAX=%0d not representable in DATA_W=%0d", SWEEP_MAX, DATA_W);
    if (DRIVE_SKEW <= 0 || 2 * DRIVE_SKEW >= CLK_PERIOD)
      $fatal(1, "DRIVE_SKEW=%0d must lie inside the first clock half-period", DRIVE_SKEW);
    if (MAX_LATENCY < 1 || MAX_LATENCY > 4096)
      $fatal(1, "MAX_LATENCY=%0d outside supported range 1..4096", MAX_LATENCY);
    if (FIXED_LATENCY && EXP_LATENCY > MAX_LATENCY)
      $fatal(1, "EXP_LATENCY=%0d exceeds MAX_LATENCY=%0d", EXP_LATENCY, MAX_LATENCY);

    master_seed = DEFAULT_SEED;
    num_random  = NUM_RANDOM;
    num_stress  = NUM_STRESS;
    void'($value$plusargs("SEED=%d", master_seed));
    void'($value$plusargs("VERBOSE=%d", verbosity));
    void'($value$plusargs("NUM_RANDOM=%d", num_random));
    void'($value$plusargs("NUM_STRESS=%d", num_stress));
    stim_state = mix64(master_seed);
    junk_state = mix64(~master_seed);

    rst_n    = 1'b0;
    in_valid = 1'b0;
    flush    = 1'b0;
    in_a     = '0;
    in_b     = '0;
    $display({"[%0t] tb_tensor_unit: N=%0d DATA_W=%0d ACC_W=%0d DUT_LATENCY=%0d EXP_LATENCY=%0d ",
              "READY=%0d FLUSH=%0d seed=%0d"},
             $time, N, DATA_W, ACC_W, DUT_LATENCY, EXP_LATENCY, HAS_READY, HAS_FLUSH, master_seed);
  endtask

  initial begin : p_main
    init_env();
    apply_reset(RESET_CYCLES);
    test_reset_quiescence();
    test_known_answer();
    test_identity();
    test_diagonal();
    test_zero();
    test_permutation();
    test_value_sweep();
    test_boundary();
    test_class_cross();
    test_random_stream();
    test_pipeline_saturation();
    test_occupancy_sweep();
    test_flush();
    test_reset_in_flight();
    test_determinism();
    finish_test();
  end

endmodule

`default_nettype wire
