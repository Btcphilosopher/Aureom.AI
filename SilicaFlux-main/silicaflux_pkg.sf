    SHF_BINV        = 6'h0C,
    SHF_BEXT        = 6'h0D,
    SHF_SLLI_UW     = 6'h0E
  } shift_op_e;

  // --- Multiply / Divide (bit[3] selects the iterative divider) --------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    MDV_MUL         = 6'h00,
    MDV_MULH        = 6'h01,
    MDV_MULHSU      = 6'h02,
    MDV_MULHU       = 6'h03,
    MDV_MULW        = 6'h04,
    MDV_DIV         = 6'h08,
    MDV_DIVU        = 6'h09,
    MDV_REM         = 6'h0A,
