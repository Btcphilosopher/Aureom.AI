  // --- CSR Access (codes mirror funct3) --------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    CSR_RW          = 6'h01,
    CSR_RS          = 6'h02,
    CSR_RC          = 6'h03,
    CSR_RWI         = 6'h05,
    CSR_RSI         = 6'h06,
    CSR_RCI         = 6'h07
  } csr_op_e;

  // --- System / Privileged ---------------------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    SYS_ECALL       = 6'h00,
    SYS_EBREAK      = 6'h01,
    SYS_SRET        = 6'h02,
    SYS_MRET        = 6'h03,
    SYS_DRET        = 6'h04,
    SYS_WFI         = 6'h05,
    SYS_WRS_NTO     = 6'h06,
    SYS_WRS_STO     = 6'h07
  } sys_op_e;

  // --- Accelerator Control (MOP_ACCEL) ---------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    CST_ACCEL_CMD   = 6'h00,
    CST_ACCEL_POLL  = 6'h01,
    CST_ACCEL_SYNC  = 6'h02,
    CST_PERF_MARK   = 6'h03,
    CST_TRACE_EMIT  = 6'h04
  } cust_op_e;

  // --- Domain-Polymorphic Function Code --------------------------------------
  typedef union packed {
    alu_op_e                arith;
    logic_op_e              lgc;
    shift_op_e              shift;
    muldiv_op_e             muldiv;
    branch_op_e             branch;
    lsu_func_t              lsu;
    amo_op_e                amo;
    fence_op_e              fence;
    fp_op_e                 fp;
    vec_op_e                vec;
    tensor_op_e             tensor;
    csr_op_e                csr;
    sys_op_e                sys;
    cust_op_e               cust;
    logic [UOP_FUNC_W-1:0]  raw;
  } uop_func_u;

  // ===========================================================================
  // 6. Execution Resources and Pipeline Topology
  // ===========================================================================

  typedef enum logic [2:0] {
    RF_NONE         = 3'd0,
    RF_INT          = 3'd1,
    RF_FP           = 3'd2,
    RF_VEC          = 3'd3,
    RF_TILE         = 3'd4
  } rf_class_e;

  typedef enum logic [3:0] {
    FU_NONE         = 4'h0,
    FU_ALU          = 4'h1,
    FU_BRU          = 4'h2,
    FU_MUL          = 4'h3,
    FU_DIV          = 4'h4,
    FU_LDU          = 4'h5,
    FU_STU          = 4'h6,
    FU_FMA          = 4'h7,
    FU_FDIV         = 4'h8,
    FU_FCVT         = 4'h9,
    FU_VALU         = 4'hA,
    FU_VMUL         = 4'hB,
    FU_VPERM        = 4'hC,
    FU_VLSU         = 4'hD,
    FU_TMMA         = 4'hE,
    FU_CSR          = 4'hF
  } fu_type_e;

  localparam int unsigned NUM_FU_TYPES = 16;
  typedef logic [NUM_FU_TYPES-1:0] fu_mask_t;

  typedef enum logic [2:0] {
    EXU_INT         = 3'd0,
    EXU_MEM         = 3'd1,
    EXU_FP          = 3'd2,
    EXU_VEC         = 3'd3,
    EXU_TNS         = 3'd4,     // decoupled; dispatched non-speculatively
    EXU_SYS         = 3'd5
  } exu_cluster_e;

  typedef enum logic [3:0] {
    PS_PCGEN        = 4'd0,
    PS_ICACHE       = 4'd1,
    PS_PREDECODE    = 4'd2,
    PS_FBUF         = 4'd3,
    PS_DECODE       = 4'd4,
    PS_RENAME       = 4'd5,
    PS_DISPATCH     = 4'd6,
    PS_ISSUE        = 4'd7,
    PS_REGREAD      = 4'd8,
    PS_EXECUTE      = 4'd9,
    PS_MEMORY       = 4'd10,
    PS_WRITEBACK    = 4'd11,
    PS_COMMIT       = 4'd12
  } pipe_stage_e;

  typedef enum logic [1:0] {
    OPA_RS1         = 2'd0,
    OPA_PC          = 2'd1,
    OPA_ZERO        = 2'd2
  } opa_sel_e;

  typedef enum logic [1:0] {
    OPB_RS2         = 2'd0,
    OPB_IMM         = 2'd1,
    OPB_ZERO        = 2'd2,
    OPB_ILEN        = 2'd3      // link value: PC + ILEN_BYTES
  } opb_sel_e;

  typedef enum logic [2:0] {
    IMM_NONE        = 3'd0,
    IMM_I           = 3'd1,
    IMM_S           = 3'd2,
    IMM_B           = 3'd3,
    IMM_U           = 3'd4,
    IMM_J           = 3'd5,
    IMM_Z           = 3'd6,     // zero-extended rs1 field (CSR uimm)
    IMM_V           = 3'd7      // sign-extended vs1 field (vector simm5)
  } imm_fmt_e;

  typedef enum logic [1:0] {
    LAT_SINGLE      = 2'd0,     // back-to-back wakeup
    LAT_FIXED       = 2'd1,     // deterministic, scheduled from lat field
    LAT_VARIABLE    = 2'd2      // completion-signalled wakeup
  } lat_class_e;

  // ===========================================================================
  // 7. Floating-Point, Vector and Tensor Configuration
  // ===========================================================================

  typedef enum logic [1:0] {
    FMT_S           = 2'b00,
    FMT_D           = 2'b01,
    FMT_H           = 2'b10,
    FMT_BF16        = 2'b11     // quad not implemented; code point reassigned
  } fp_fmt_e;

  typedef enum logic [2:0] {
    RM_RNE          = 3'b000,
    RM_RTZ          = 3'b001,
    RM_RDN          = 3'b010,
    RM_RUP          = 3'b011,
    RM_RMM          = 3'b100,
    RM_DYN          = 3'b111
  } fp_rm_e;

  typedef struct packed {
    logic                   nv;
