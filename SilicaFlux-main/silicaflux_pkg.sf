    MDV_DIVUW       = 6'h0D,
    MDV_REMW        = 6'h0E,
    MDV_REMUW       = 6'h0F
  } muldiv_op_e;

  // --- Control Transfer (conditional codes mirror funct3) --------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    BRU_BEQ         = 6'h00,
    BRU_BNE         = 6'h01,
    BRU_BLT         = 6'h04,
    BRU_BGE         = 6'h05,
    BRU_BLTU        = 6'h06,
    BRU_BGEU        = 6'h07,
    BRU_JAL         = 6'h10,
    BRU_JALR        = 6'h11
  } branch_op_e;

  // --- Memory Access Size ----------------------------------------------------
  typedef enum logic [2:0] {
    MSZ_B           = 3'd0,     //  1 B
    MSZ_H           = 3'd1,     //  2 B
    MSZ_W           = 3'd2,     //  4 B
    MSZ_D           = 3'd3,     //  8 B
    MSZ_Q           = 3'd4,     // 16 B
    MSZ_O           = 3'd5,     // 32 B
    MSZ_L           = 3'd6      // 64 B (full cache line)
  } mem_size_e;

  // --- Load / Store Function Descriptor --------------------------------------
  typedef struct packed {
    logic                   is_fp;
    logic                   sext;
    logic                   ntl;        // non-temporal locality hint
    mem_size_e              size;
  } lsu_func_t;

  // --- Atomic Memory Operations (codes mirror funct5) ------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    AMO_ADD         = 6'h00,
    AMO_SWAP        = 6'h01,
    AMO_LR          = 6'h02,
    AMO_SC          = 6'h03,
    AMO_XOR         = 6'h04,
    AMO_CAS         = 6'h05,
    AMO_OR          = 6'h08,
    AMO_AND         = 6'h0C,
    AMO_MIN         = 6'h10,
    AMO_MAX         = 6'h14,
    AMO_MINU        = 6'h18,
    AMO_MAXU        = 6'h1C
  } amo_op_e;

  // --- Ordering / Cache-Management / Translation Fences ----------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    FNC_FENCE       = 6'h00,
    FNC_FENCE_TSO   = 6'h01,
    FNC_FENCE_I     = 6'h02,
    FNC_SFENCE_VMA  = 6'h03,
    FNC_HFENCE_VVMA = 6'h04,
    FNC_HFENCE_GVMA = 6'h05,
    FNC_SINVAL_VMA  = 6'h06,
    FNC_CBO_INVAL   = 6'h08,
    FNC_CBO_CLEAN   = 6'h09,
    FNC_CBO_FLUSH   = 6'h0A,
    FNC_CBO_ZERO    = 6'h0B,
    FNC_PREFETCH_I  = 6'h0C,
    FNC_PREFETCH_R  = 6'h0D,
    FNC_PREFETCH_W  = 6'h0E
  } fence_op_e;

  // --- Scalar Floating Point -------------------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    FPU_FADD        = 6'h00,
