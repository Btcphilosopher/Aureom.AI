// =============================================================================
//  silicaflux_pkg.sf
// -----------------------------------------------------------------------------
//  Silica Flux Architecture (SFA) - Core Architectural Package
//
//  Language     : Silica Flux-2017
//  Contents     : Architectural parameters, ISA encoding, micro-op taxonomy,
//                 execution-resource enumerations, pipeline transaction types,
//                 memory-subsystem types, exception / trap metadata, utility
//                 types and pure combinational helper functions.
//
//  Conventions  : *_e  enumerated type        *_t  struct / typedef
//                 *_u  packed union           UPPER_CASE  parameters
//                 All widths derive from Section 2. Every enumeration carries
//                 explicit encodings; values are architecturally frozen once
//                 published and may only be extended into unused code points.
//
//  Constraints  : Stateless. No clocked constructs, no macros, no `define.
//                 All functions are automatic and side-effect free.
// =============================================================================

package silicaflux_pkg;

  // ===========================================================================
  // 1. Architectural Identity
  // ===========================================================================

  localparam logic [7:0]   SF_ARCH_VER_MAJOR   = 8'd2;
  localparam logic [7:0]   SF_ARCH_VER_MINOR   = 8'd4;
  localparam logic [7:0]   SF_ARCH_VER_PATCH   = 8'd0;

  localparam logic [31:0]  SF_MVENDORID        = 32'h0000_0000;
  localparam logic [63:0]  SF_MARCHID          = 64'h8000_0000_0000_5346;
  localparam logic [63:0]  SF_MIMPID           = {40'h0,
                                                  SF_ARCH_VER_MAJOR,
                                                  SF_ARCH_VER_MINOR,
                                                  SF_ARCH_VER_PATCH};

  // ===========================================================================
  // 2. Global Architectural Parameters
  // ===========================================================================

  // --- Datapath --------------------------------------------------------------
  localparam int unsigned XLEN                = 64;
  localparam int unsigned XLEN_BYTES          = XLEN / 8;
  localparam int unsigned XLEN_OFF_W          = $clog2(XLEN_BYTES);
  localparam int unsigned FLEN                = 64;
  localparam int unsigned ILEN                = 32;
  localparam int unsigned ILEN_BYTES          = ILEN / 8;
  localparam int unsigned INSTR_OFF_W         = $clog2(ILEN_BYTES);
  localparam int unsigned IMM_W               = 32;

  // --- Encoding Field Widths -------------------------------------------------
  localparam int unsigned OPCODE_W            = 7;
  localparam int unsigned FUNCT3_W            = 3;
  localparam int unsigned FUNCT5_W            = 5;
  localparam int unsigned FUNCT6_W            = 6;
  localparam int unsigned FUNCT7_W            = 7;
  localparam int unsigned IMM_I_W             = 12;
  localparam int unsigned IMM_U_W             = 20;
  localparam int unsigned UOP_FUNC_W          = 6;

  // --- Address Space (Sv48 / Sv48x4) -----------------------------------------
  localparam int unsigned VADDR_W             = 48;
  localparam int unsigned PADDR_W             = 56;
  localparam int unsigned GPADDR_W            = 50;
  localparam int unsigned PAGE_OFFSET_W       = 12;
  localparam int unsigned VPN_W               = VADDR_W - PAGE_OFFSET_W;
  localparam int unsigned PPN_W               = PADDR_W - PAGE_OFFSET_W;
  localparam int unsigned PT_LEVELS           = 4;
  localparam int unsigned PT_LEVEL_W          = $clog2(PT_LEVELS);
  localparam int unsigned VPN_SEG_W           = VPN_W / PT_LEVELS;
  localparam int unsigned ASID_W              = 16;
  localparam int unsigned VMID_W              = 14;

  // --- Architectural Register Files ------------------------------------------
  localparam int unsigned AREG_NUM            = 32;
  localparam int unsigned AREG_W              = $clog2(AREG_NUM);
  localparam int unsigned TILE_REGS           = 8;
  localparam int unsigned TILE_IDX_W          = $clog2(TILE_REGS);
  localparam int unsigned NUM_SRC             = 3;

  // --- Physical Register Files -----------------------------------------------
  localparam int unsigned PRF_INT_REGS        = 256;
  localparam int unsigned PRF_FP_REGS         = 192;
  localparam int unsigned PRF_VEC_REGS        = 96;
  localparam int unsigned PRF_MAX_REGS        =
      (PRF_INT_REGS > PRF_FP_REGS)
        ? ((PRF_INT_REGS > PRF_VEC_REGS) ? PRF_INT_REGS : PRF_VEC_REGS)
        : ((PRF_FP_REGS  > PRF_VEC_REGS) ? PRF_FP_REGS  : PRF_VEC_REGS);
  localparam int unsigned PREG_W              = $clog2(PRF_MAX_REGS);

  // --- Front-End Pipeline Widths ---------------------------------------------
  localparam int unsigned FETCH_WIDTH         = 8;
  localparam int unsigned FETCH_BYTES         = FETCH_WIDTH * ILEN_BYTES;
  localparam int unsigned FETCH_OFF_W         = $clog2(FETCH_BYTES);
  localparam int unsigned FETCH_SLOT_W        = $clog2(FETCH_WIDTH);
  localparam int unsigned FETCH_BUF_DEPTH     = 32;
  localparam int unsigned FTQ_DEPTH           = 64;
  localparam int unsigned FTQ_IDX_W           = $clog2(FTQ_DEPTH);

  // --- Back-End Pipeline Widths ----------------------------------------------
  localparam int unsigned DECODE_WIDTH        = 6;
  localparam int unsigned RENAME_WIDTH        = 6;
  localparam int unsigned DISPATCH_WIDTH      = 6;
  localparam int unsigned COMMIT_WIDTH        = 6;

  localparam int unsigned LD_PIPES            = 2;
  localparam int unsigned STA_PIPES           = 1;
  localparam int unsigned ISSUE_INT           = 4;
  localparam int unsigned ISSUE_MEM           = LD_PIPES + STA_PIPES;
  localparam int unsigned ISSUE_FP            = 2;
  localparam int unsigned ISSUE_VEC           = 1;
  localparam int unsigned ISSUE_WIDTH         = ISSUE_INT + ISSUE_MEM
                                              + ISSUE_FP  + ISSUE_VEC;

  localparam int unsigned WB_INT_PORTS        = ISSUE_INT + LD_PIPES;
  localparam int unsigned WB_FP_PORTS         = ISSUE_FP  + LD_PIPES;
  localparam int unsigned WB_WIDTH            = WB_INT_PORTS + WB_FP_PORTS;

  // --- Out-of-Order Resources ------------------------------------------------
  localparam int unsigned ROB_DEPTH           = 256;
  localparam int unsigned ROB_IDX_W           = $clog2(ROB_DEPTH);
  localparam int unsigned IQ_INT_DEPTH        = 64;
  localparam int unsigned IQ_MEM_DEPTH        = 48;
  localparam int unsigned IQ_FP_DEPTH         = 48;
  localparam int unsigned IQ_VEC_DEPTH        = 32;
  localparam int unsigned LDQ_DEPTH           = 96;
  localparam int unsigned LDQ_IDX_W           = $clog2(LDQ_DEPTH);
  localparam int unsigned STQ_DEPTH           = 64;
  localparam int unsigned STQ_IDX_W           = $clog2(STQ_DEPTH);
  localparam int unsigned LSQ_IDX_W           = (LDQ_IDX_W > STQ_IDX_W) ? LDQ_IDX_W
                                                                       : STQ_IDX_W;
  localparam int unsigned MAX_BR_INFLIGHT     = 32;
  localparam int unsigned BR_TAG_W            = $clog2(MAX_BR_INFLIGHT);
  localparam int unsigned LAT_W               = 4;

  // --- Memory Dependence Prediction ------------------------------------------
  localparam int unsigned SSIT_ENTRIES        = 1024;
  localparam int unsigned LFST_ENTRIES        = 128;
  localparam int unsigned SSID_W              = $clog2(LFST_ENTRIES);

  // --- Branch Prediction -----------------------------------------------------
  localparam int unsigned GHIST_BUF_DEPTH     = 1024;
  localparam int unsigned GHIST_PTR_W         = $clog2(GHIST_BUF_DEPTH);
  localparam int unsigned TAGE_TABLES         = 8;
  localparam int unsigned TAGE_PROV_W         = $clog2(TAGE_TABLES + 1);
  localparam int unsigned BP_CTR_W            = 3;
  localparam int unsigned BP_CONF_CTR_W       = 4;
  localparam int unsigned BTB_ENTRIES         = 4096;
  localparam int unsigned BTB_WAYS            = 4;
  localparam int unsigned BTB_WAY_W           = $clog2(BTB_WAYS);
  localparam int unsigned RAS_DEPTH           = 32;
  localparam int unsigned RAS_PTR_W           = $clog2(RAS_DEPTH);

  // --- Cache Hierarchy -------------------------------------------------------
  localparam int unsigned CL_BYTES            = 64;
  localparam int unsigned CL_W                = CL_BYTES * 8;
  localparam int unsigned CL_OFFSET_W         = $clog2(CL_BYTES);
  localparam int unsigned LINE_ADDR_W         = PADDR_W - CL_OFFSET_W;
  localparam int unsigned L1_IDX_W            = PAGE_OFFSET_W - CL_OFFSET_W;
  localparam int unsigned L1_SETS             = 1 << L1_IDX_W;
  localparam int unsigned L1_TAG_W            = PPN_W;
  localparam int unsigned L1I_WAYS            = 8;
  localparam int unsigned L1D_WAYS            = 12;
  localparam int unsigned L1I_MSHRS           = 4;
  localparam int unsigned L1D_MSHRS           = 16;
  localparam int unsigned MSHR_IDX_W          = $clog2(L1D_MSHRS);
  localparam int unsigned L2_SETS             = 1024;
  localparam int unsigned L2_WAYS             = 16;
  localparam int unsigned L2_IDX_W            = $clog2(L2_SETS);
  localparam int unsigned L2_TAG_W            = LINE_ADDR_W - L2_IDX_W;
  localparam int unsigned ECC_DATA_W          = 64;
  localparam int unsigned ECC_CHECK_W         = 8;

  // --- Translation -----------------------------------------------------------
  localparam int unsigned ITLB_ENTRIES        = 64;
  localparam int unsigned DTLB_ENTRIES        = 64;
  localparam int unsigned STLB_ENTRIES        = 2048;
  localparam int unsigned STLB_WAYS           = 8;
  localparam int unsigned PMP_ENTRIES         = 16;

  // --- Coherent System -------------------------------------------------------
  localparam int unsigned NUM_CORES           = 16;
  localparam int unsigned CORE_ID_W           = $clog2(NUM_CORES);
  localparam int unsigned TXN_SRC_W           = 2;
  localparam int unsigned TXN_ID_W            = CORE_ID_W + TXN_SRC_W + MSHR_IDX_W;

  // --- System Interconnect (AXI4 profile) ------------------------------------
  localparam int unsigned AXI_ADDR_W          = PADDR_W;
  localparam int unsigned AXI_DATA_W          = 256;
  localparam int unsigned AXI_STRB_W          = AXI_DATA_W / 8;
  localparam int unsigned AXI_ID_W            = TXN_ID_W;
  localparam int unsigned AXI_USER_W          = 4;
  localparam int unsigned AXI_LEN_W           = 8;
  localparam int unsigned AXI_SIZE_W          = 3;
  localparam int unsigned AXI_CACHE_W         = 4;
  localparam int unsigned AXI_PROT_W          = 3;
  localparam int unsigned AXI_QOS_W           = 4;
  localparam int unsigned AXI_REGION_W        = 4;
  localparam int unsigned AXI_BEATS_PER_CL    = CL_W / AXI_DATA_W;

  // --- Vector Extension ------------------------------------------------------
  localparam int unsigned VLEN                = 512;
  localparam int unsigned VLENB               = VLEN / 8;
  localparam int unsigned ELEN                = 64;
  localparam int unsigned VEC_LANES           = VLEN / ELEN;
  localparam int unsigned VLMAX               = VLEN;
  localparam int unsigned VL_W                = $clog2(VLMAX) + 1;

  // --- Tensor Extension ------------------------------------------------------
  localparam int unsigned TILE_ROWS           = 16;
  localparam int unsigned TILE_COLB           = 64;
  localparam int unsigned TILE_ROW_W          = $clog2(TILE_ROWS) + 1;
  localparam int unsigned TILE_COLB_W         = $clog2(TILE_COLB) + 1;
  localparam int unsigned TCQ_DEPTH           = 16;

  // --- Privilege / CSR / Interrupt -------------------------------------------
  localparam int unsigned CSR_ADDR_W          = 12;
  localparam int unsigned CAUSE_W             = 6;
  localparam int unsigned IRQ_VEC_W           = XLEN;
  localparam int unsigned IRQ_PRIO_W          = 3;

  // ===========================================================================
  // 3. Fundamental Typedefs and Ordered Identifiers
  // ===========================================================================

  typedef logic [XLEN-1:0]          xlen_t;
  typedef logic [FLEN-1:0]          flen_t;
  typedef logic [VADDR_W-1:0]       vaddr_t;
  typedef logic [PADDR_W-1:0]       paddr_t;
  typedef logic [LINE_ADDR_W-1:0]   line_addr_t;
  typedef logic [CL_W-1:0]          cl_data_t;
  typedef logic [CL_BYTES-1:0]      cl_mask_t;
  typedef logic [IMM_W-1:0]         imm_t;
  typedef logic [CSR_ADDR_W-1:0]    csr_addr_t;

  // Circular-buffer identifiers carry a wrap bit for O(1) age comparison.
  typedef struct packed {
    logic                   wrap;
    logic [ROB_IDX_W-1:0]   idx;
  } rob_id_t;

  typedef struct packed {
    logic                   wrap;
    logic [LDQ_IDX_W-1:0]   idx;
  } ldq_id_t;

  typedef struct packed {
    logic                   wrap;
    logic [STQ_IDX_W-1:0]   idx;
  } stq_id_t;

  typedef struct packed {
    logic [FTQ_IDX_W-1:0]    idx;
    logic [FETCH_SLOT_W-1:0] slot;
  } ftq_ref_t;

  typedef logic [BR_TAG_W-1:0]        br_tag_t;
  typedef logic [MAX_BR_INFLIGHT-1:0] br_mask_t;
  typedef logic [LD_PIPES-1:0]        ld_spec_mask_t;

  // ===========================================================================
  // 4. Instruction Encoding
  // ===========================================================================

  // --- Major Opcode Map (inst[6:0]) ------------------------------------------
  typedef enum logic [OPCODE_W-1:0] {
    MOP_LOAD        = 7'b000_0011,
    MOP_LOAD_FP     = 7'b000_0111,
    MOP_TENSOR      = 7'b000_1011,  // custom-0 : SF tensor extension
    MOP_MISC_MEM    = 7'b000_1111,
    MOP_OP_IMM      = 7'b001_0011,
    MOP_AUIPC       = 7'b001_0111,
    MOP_OP_IMM_32   = 7'b001_1011,
    MOP_STORE       = 7'b010_0011,
    MOP_STORE_FP    = 7'b010_0111,
    MOP_ACCEL       = 7'b010_1011,  // custom-1 : SF accelerator control
    MOP_AMO         = 7'b010_1111,
    MOP_OP          = 7'b011_0011,
    MOP_LUI         = 7'b011_0111,
    MOP_OP_32       = 7'b011_1011,
    MOP_MADD        = 7'b100_0011,
    MOP_MSUB        = 7'b100_0111,
    MOP_NMSUB       = 7'b100_1011,
    MOP_NMADD       = 7'b100_1111,
    MOP_OP_FP       = 7'b101_0011,
    MOP_OP_V        = 7'b101_0111,
    MOP_CUSTOM_2    = 7'b101_1011,  // reserved for future heterogeneous units
    MOP_BRANCH      = 7'b110_0011,
    MOP_JALR        = 7'b110_0111,
    MOP_JAL         = 7'b110_1111,
    MOP_SYSTEM      = 7'b111_0011,
    MOP_CUSTOM_3    = 7'b111_1011   // reserved for future heterogeneous units
  } sf_opcode_e;

  // --- Minor Opcode Tables ---------------------------------------------------
  typedef enum logic [FUNCT3_W-1:0] {
    F3_BEQ          = 3'b000,
    F3_BNE          = 3'b001,
    F3_BLT          = 3'b100,
    F3_BGE          = 3'b101,
    F3_BLTU         = 3'b110,
    F3_BGEU         = 3'b111
  } f3_branch_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_LB           = 3'b000,
    F3_LH           = 3'b001,
    F3_LW           = 3'b010,
    F3_LD           = 3'b011,
    F3_LBU          = 3'b100,
    F3_LHU          = 3'b101,
    F3_LWU          = 3'b110
  } f3_load_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_SB           = 3'b000,
    F3_SH           = 3'b001,
    F3_SW           = 3'b010,
    F3_SD           = 3'b011
  } f3_store_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_ADD_SUB      = 3'b000,
    F3_SLL          = 3'b001,
    F3_SLT          = 3'b010,
    F3_SLTU         = 3'b011,
    F3_XOR          = 3'b100,
    F3_SRL_SRA      = 3'b101,
    F3_OR           = 3'b110,
    F3_AND          = 3'b111
  } f3_op_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_MUL          = 3'b000,
    F3_MULH         = 3'b001,
    F3_MULHSU       = 3'b010,
    F3_MULHU        = 3'b011,
    F3_DIV          = 3'b100,
    F3_DIVU         = 3'b101,
    F3_REM          = 3'b110,
    F3_REMU         = 3'b111
  } f3_muldiv_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_FENCE        = 3'b000,
    F3_FENCE_I      = 3'b001,
    F3_CBO          = 3'b010
  } f3_misc_mem_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_AMO_W        = 3'b010,
    F3_AMO_D        = 3'b011
  } f3_amo_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_PRIV         = 3'b000,
    F3_CSRRW        = 3'b001,
    F3_CSRRS        = 3'b010,
    F3_CSRRC        = 3'b011,
    F3_CSRRWI       = 3'b101,
    F3_CSRRSI       = 3'b110,
    F3_CSRRCI       = 3'b111
  } f3_system_e;

  typedef enum logic [FUNCT3_W-1:0] {
    F3_OPIVV        = 3'b000,
    F3_OPFVV        = 3'b001,
    F3_OPMVV        = 3'b010,
    F3_OPIVI        = 3'b011,
    F3_OPIVX        = 3'b100,
    F3_OPFVF        = 3'b101,
    F3_OPMVX        = 3'b110,
    F3_OPCFG        = 3'b111
  } f3_vector_e;

  // Tensor operand form, carried in funct3 of MOP_TENSOR.
  typedef enum logic [FUNCT3_W-1:0] {
    TFORM_TT        = 3'b000,   // tile  <- tile  op tile
    TFORM_TX        = 3'b001,   // tile  <- tile  op xreg
    TFORM_TM        = 3'b010,   // tile <-> memory [rs1] stride [rs2]
    TFORM_CFG       = 3'b011    // configuration from xreg
  } tns_form_e;

  localparam logic [FUNCT7_W-1:0] F7_BASE     = 7'b000_0000;
  localparam logic [FUNCT7_W-1:0] F7_MULDIV   = 7'b000_0001;
  localparam logic [FUNCT7_W-1:0] F7_MINMAX   = 7'b000_0101;
  localparam logic [FUNCT7_W-1:0] F7_CZERO    = 7'b000_0111;
  localparam logic [FUNCT7_W-1:0] F7_SHADD    = 7'b001_0000;
  localparam logic [FUNCT7_W-1:0] F7_ALT      = 7'b010_0000;
  localparam logic [FUNCT7_W-1:0] F7_ROTATE   = 7'b011_0000;

  // --- Instruction Formats ---------------------------------------------------
  typedef struct packed {
    logic [FUNCT7_W-1:0]    funct7;
    logic [AREG_W-1:0]      rs2;
    logic [AREG_W-1:0]      rs1;
    logic [FUNCT3_W-1:0]    funct3;
    logic [AREG_W-1:0]      rd;
    sf_opcode_e             opcode;
  } instr_r_t;

  typedef struct packed {
    logic [IMM_I_W-1:0]     imm;
    logic [AREG_W-1:0]      rs1;
    logic [FUNCT3_W-1:0]    funct3;
    logic [AREG_W-1:0]      rd;
    sf_opcode_e             opcode;
  } instr_i_t;

  typedef struct packed {
    logic [6:0]             imm_hi;
    logic [AREG_W-1:0]      rs2;
    logic [AREG_W-1:0]      rs1;
    logic [FUNCT3_W-1:0]    funct3;
    logic [4:0]             imm_lo;
    sf_opcode_e             opcode;
  } instr_s_t;

  typedef struct packed {
    logic                   imm12;
    logic [5:0]             imm10_5;
    logic [AREG_W-1:0]      rs2;
    logic [AREG_W-1:0]      rs1;
    logic [FUNCT3_W-1:0]    funct3;
    logic [3:0]             imm4_1;
    logic                   imm11;
    sf_opcode_e             opcode;
  } instr_b_t;

  typedef struct packed {
    logic [IMM_U_W-1:0]     imm;
    logic [AREG_W-1:0]      rd;
    sf_opcode_e             opcode;
  } instr_u_t;

  typedef struct packed {
    logic                   imm20;
    logic [9:0]             imm10_1;
    logic                   imm11;
    logic [7:0]             imm19_12;
    logic [AREG_W-1:0]      rd;
    sf_opcode_e             opcode;
  } instr_j_t;

  typedef struct packed {
    logic [AREG_W-1:0]      rs3;
    logic [1:0]             fmt;
    logic [AREG_W-1:0]      rs2;
    logic [AREG_W-1:0]      rs1;
    logic [FUNCT3_W-1:0]    rm;
    logic [AREG_W-1:0]      rd;
    sf_opcode_e             opcode;
  } instr_r4_t;

  typedef struct packed {
    logic [FUNCT6_W-1:0]    funct6;
    logic                   vm;
    logic [AREG_W-1:0]      vs2;
    logic [AREG_W-1:0]      vs1;
    f3_vector_e             funct3;
    logic [AREG_W-1:0]      vd;
    sf_opcode_e             opcode;
  } instr_v_t;

  typedef struct packed {
    logic [FUNCT6_W-1:0]    funct6;
    logic                   acc;
    logic [AREG_W-1:0]      rs2;
    logic [AREG_W-1:0]      rs1;
    tns_form_e              form;
    logic [AREG_W-1:0]      td;
    sf_opcode_e             opcode;
  } instr_tns_t;

  typedef union packed {
    instr_r_t               r;
    instr_i_t               i;
    instr_s_t               s;
    instr_b_t               b;
    instr_u_t               u;
    instr_j_t               j;
    instr_r4_t              r4;
    instr_v_t               v;
    instr_tns_t             t;
    logic [ILEN-1:0]        raw;
  } instr_t;

  // ===========================================================================
  // 5. Micro-Op Taxonomy
  // ===========================================================================
  //  Two-level hierarchy: op_class_e selects the functional domain; a
  //  domain-specific function code of UOP_FUNC_W bits is carried in
  //  uop_func_u. Domains extend independently without global re-encoding.

  typedef enum logic [3:0] {
    OPC_NONE        = 4'h0,
    OPC_ARITH       = 4'h1,
    OPC_LOGIC       = 4'h2,
    OPC_SHIFT       = 4'h3,
    OPC_MULDIV      = 4'h4,
    OPC_BRANCH      = 4'h5,
    OPC_LOAD        = 4'h6,
    OPC_STORE       = 4'h7,
    OPC_ATOMIC      = 4'h8,
    OPC_FENCE       = 4'h9,
    OPC_FP          = 4'hA,
    OPC_VECTOR      = 4'hB,
    OPC_TENSOR      = 4'hC,
    OPC_CSR         = 4'hD,
    OPC_SYSTEM      = 4'hE,
    OPC_CUSTOM      = 4'hF
  } op_class_e;

  // --- Integer Arithmetic ----------------------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    ALU_ADD         = 6'h00,
    ALU_SUB         = 6'h01,
    ALU_ADDW        = 6'h02,
    ALU_SUBW        = 6'h03,
    ALU_SLT         = 6'h04,
    ALU_SLTU        = 6'h05,
    ALU_LUI         = 6'h06,
    ALU_AUIPC       = 6'h07,
    ALU_MIN         = 6'h08,
    ALU_MAX         = 6'h09,
    ALU_MINU        = 6'h0A,
    ALU_MAXU        = 6'h0B,
    ALU_SH1ADD      = 6'h0C,
    ALU_SH2ADD      = 6'h0D,
    ALU_SH3ADD      = 6'h0E,
    ALU_ADD_UW      = 6'h0F,
    ALU_SH1ADD_UW   = 6'h10,
    ALU_SH2ADD_UW   = 6'h11,
    ALU_SH3ADD_UW   = 6'h12,
    ALU_CZERO_EQZ   = 6'h13,
    ALU_CZERO_NEZ   = 6'h14
  } alu_op_e;

  // --- Integer Logical / Bit-Manipulation ------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    LGC_AND         = 6'h00,
    LGC_OR          = 6'h01,
    LGC_XOR         = 6'h02,
    LGC_ANDN        = 6'h03,
    LGC_ORN         = 6'h04,
    LGC_XNOR        = 6'h05,
    LGC_CLZ         = 6'h06,
    LGC_CTZ         = 6'h07,
    LGC_CPOP        = 6'h08,
    LGC_CLZW        = 6'h09,
    LGC_CTZW        = 6'h0A,
