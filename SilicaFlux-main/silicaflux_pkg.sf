  // --- Tensor / AI (codes equal funct6 of MOP_TENSOR) ------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    TNS_CFG         = 6'h00,
    TNS_ZERO        = 6'h01,
    TNS_LOAD        = 6'h02,
