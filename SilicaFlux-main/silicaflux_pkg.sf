    LGC_SEXT_H      = 6'h0D,
    LGC_ZEXT_H      = 6'h0E,
    LGC_REV8        = 6'h0F,
    LGC_ORC_B       = 6'h10
  } logic_op_e;

  // --- Shift / Rotate / Single-Bit -------------------------------------------
  typedef enum logic [UOP_FUNC_W-1:0] {
    SHF_SLL         = 6'h00,
    SHF_SRL         = 6'h01,
    SHF_SRA         = 6'h02,
    SHF_SLLW        = 6'h03,
    SHF_SRLW        = 6'h04,
    SHF_SRAW        = 6'h05,
    SHF_ROL         = 6'h06,
    SHF_ROR         = 6'h07,
