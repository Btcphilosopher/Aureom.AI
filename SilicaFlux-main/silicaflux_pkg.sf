  // MXL=64 | Extensions: A D F H I M S U V X
  //                                ZYXWVUTSRQPONMLKJIHGFEDCBA
  localparam logic [XLEN-1:0] SF_MISA = {2'b10, {(XLEN-28){1'b0}},
                                         26'b00101101000001000110101001};

  // ===========================================================================
  // 9. Exceptions, Interrupts and Traps
  // ===========================================================================

  typedef enum logic [CAUSE_W-1:0] {
    EXC_IADDR_MISALIGNED    = 6'd0,
    EXC_IACCESS_FAULT       = 6'd1,
    EXC_ILLEGAL_INSTR       = 6'd2,
    EXC_BREAKPOINT          = 6'd3,
    EXC_LADDR_MISALIGNED    = 6'd4,
    EXC_LACCESS_FAULT       = 6'd5,
    EXC_SADDR_MISALIGNED    = 6'd6,
    EXC_SACCESS_FAULT       = 6'd7,
    EXC_ECALL_U             = 6'd8,
    EXC_ECALL_S             = 6'd9,
    EXC_ECALL_VS            = 6'd10,
    EXC_ECALL_M             = 6'd11,
    EXC_IPAGE_FAULT         = 6'd12,
    EXC_LPAGE_FAULT         = 6'd13,
    EXC_SPAGE_FAULT         = 6'd15,
    EXC_SW_CHECK            = 6'd18,
    EXC_HW_ERROR            = 6'd19,
    EXC_IGUEST_PAGE_FAULT   = 6'd20,
    EXC_LGUEST_PAGE_FAULT   = 6'd21,
    EXC_VIRTUAL_INSTR       = 6'd22,
    EXC_SGUEST_PAGE_FAULT   = 6'd23,
    EXC_TENSOR_FAULT        = 6'd24,    // implementation-defined
    EXC_ACCEL_FAULT         = 6'd25     // implementation-defined
  } exc_cause_e;

  typedef enum logic [CAUSE_W-1:0] {
    IRQ_SSI                 = 6'd1,
    IRQ_VSSI                = 6'd2,
    IRQ_MSI                 = 6'd3,
    IRQ_STI                 = 6'd5,
    IRQ_VSTI                = 6'd6,
    IRQ_MTI                 = 6'd7,
    IRQ_SEI                 = 6'd9,
    IRQ_VSEI                = 6'd10,
    IRQ_MEI                 = 6'd11,
    IRQ_SGEI                = 6'd12,
    IRQ_LCOFI               = 6'd13,
    IRQ_TENSOR_DONE         = 6'd16,    // platform-local
    IRQ_RAS_CE              = 6'd17,    // platform-local
    IRQ_RAS_UE              = 6'd18     // platform-local
  } irq_cause_e;

  typedef enum logic [3:0] {
    FLT_NONE        = 4'd0,
    FLT_ALIGN       = 4'd1,
    FLT_ACCESS      = 4'd2,
    FLT_PAGE        = 4'd3,
    FLT_GUEST_PAGE  = 4'd4,
    FLT_ILLEGAL     = 4'd5,
    FLT_VIRT_INSTR  = 4'd6,
    FLT_PRIV        = 4'd7,
    FLT_ECC_CORR    = 4'd8,
    FLT_ECC_UNCORR  = 4'd9,
    FLT_BUS_ERR     = 4'd10,
    FLT_TIMEOUT     = 4'd11,
    FLT_DEBUG       = 4'd12,
    FLT_SW_CHECK    = 4'd13
  } fault_class_e;

  typedef enum logic [2:0] {
    ACC_FETCH       = 3'd0,
    ACC_LOAD        = 3'd1,
    ACC_STORE       = 3'd2,
    ACC_AMO         = 3'd3,
    ACC_PTW         = 3'd4,
    ACC_VLOAD       = 3'd5,
    ACC_VSTORE      = 3'd6,
    ACC_TENSOR      = 3'd7
  } access_type_e;

  typedef enum logic [1:0] {
    ECC_OK          = 2'd0,
    ECC_CORRECTED   = 2'd1,
    ECC_UNCORR      = 2'd2,
    ECC_POISON      = 2'd3
  } ecc_status_e;

  typedef union packed {
    exc_cause_e             exc;
    irq_cause_e             irq;
    logic [CAUSE_W-1:0]     raw;
  } trap_cause_u;

  // Compact form travelling with in-flight uops; tval held in ROB side-table.
  typedef struct packed {
    logic                   valid;
    exc_cause_e             cause;
    fault_class_e           fclass;
  } exc_meta_t;

  // Full architectural trap record presented to the trap / CSR unit.
  typedef struct packed {
    logic                   valid;
    logic                   is_irq;
    trap_cause_u            cause;
    fault_class_e           fclass;
    priv_mode_t             target;
    vaddr_t                 epc;
    xlen_t                  tval;
    xlen_t                  tval2;      // guest physical address >> 2
    logic [ILEN-1:0]        tinst;
  } trap_info_t;

  typedef logic [IRQ_VEC_W-1:0] irq_vec_t;

  typedef struct packed {
    logic                   valid;
    logic                   nmi;
    irq_cause_e             cause;
    priv_mode_t             target;
    logic [IRQ_PRIO_W-1:0]  prio;
  } irq_req_t;

  typedef enum logic [1:0] {
    TVEC_DIRECT     = 2'b00,
    TVEC_VECTORED   = 2'b01
  } tvec_mode_e;

  // ===========================================================================
  // 10. Branch Prediction Metadata
  // ===========================================================================

  typedef enum logic [2:0] {
    BR_NONE         = 3'd0,
    BR_COND         = 3'd1,
    BR_JUMP         = 3'd2,
    BR_CALL         = 3'd3,
    BR_RET          = 3'd4,
    BR_IND          = 3'd5,
    BR_IND_CALL     = 3'd6,
    BR_CORET        = 3'd7      // pop then push
  } branch_type_e;

  typedef enum logic [1:0] {
    CONF_NONE       = 2'd0,
    CONF_LOW        = 2'd1,
    CONF_MED        = 2'd2,
    CONF_HIGH       = 2'd3
  } bp_conf_e;

  typedef struct packed {
    bp_conf_e                 level;
    logic [BP_CONF_CTR_W-1:0] ctr;
  } pred_conf_t;

  // Checkpoint captured at prediction; returned to predictor at update.
  typedef struct packed {
    branch_type_e             br_type;
    logic                     taken;
    logic                     btb_hit;
    logic [BTB_WAY_W-1:0]     btb_way;
    logic [TAGE_PROV_W-1:0]   provider;     // 0 : base bimodal
    logic [TAGE_PROV_W-1:0]   alt_provider;
    logic [BP_CTR_W-1:0]      provider_ctr;
    logic                     alt_taken;
    logic                     sc_override;
    logic                     loop_hit;
    pred_conf_t               conf;
    logic [GHIST_PTR_W-1:0]   ghist_ptr;
    logic [RAS_PTR_W-1:0]     ras_ptr;
  } bp_meta_t;

  // Per-uop prediction view carried through the back end.
  typedef struct packed {
    branch_type_e             br_type;
    logic                     taken;
    bp_conf_e                 conf;
  } bp_slot_pred_t;

  typedef struct packed {
    logic                     valid;
    vaddr_t                   pc;
    branch_type_e             br_type;
    logic                     taken;
    logic                     mispredict;
    vaddr_t                   target;
    bp_meta_t                 meta;
  } bp_update_t;

  // ===========================================================================
  // 11. Decode and Control Structures
  // ===========================================================================

  typedef struct packed {
    rf_class_e              rf;
    logic [AREG_W-1:0]      idx;
  } areg_t;

  typedef struct packed {
    rf_class_e              rf;
    logic [PREG_W-1:0]      idx;
  } preg_t;

  // Execution-time control: the minimal set forwarded past dispatch.
  typedef struct packed {
    op_class_e              op_class;
    uop_func_u              func;
    fu_type_e               fu;
    opa_sel_e               opa_sel;
    opb_sel_e               opb_sel;
    fp_fmt_e                fp_fmt;
    fp_rm_e                 fp_rm;
    logic                   is_word;
  } exec_ctrl_t;

  // Pre-decoded attributes; removes class re-decode from critical paths.
  typedef struct packed {
    logic                   is_br;
    logic                   is_jal;
    logic                   is_jalr;
    logic                   is_load;
    logic                   is_store;
    logic                   is_amo;
    logic                   is_fence;
    logic                   is_csr;
    logic                   is_vec;
    logic                   is_tensor;
    logic                   serialize;      // drain ROB before dispatch
    logic                   flush_after;    // refetch after commit
    logic                   non_spec;       // execute only at ROB head
    logic                   wr_fflags;
    logic                   rd_vcfg;
    logic                   wr_vcfg;
  } uop_flags_t;

  typedef struct packed {
    exec_ctrl_t             exe;
    exu_cluster_e           cluster;
    imm_fmt_e               imm_fmt;
    lat_class_e             lat_class;
    logic [LAT_W-1:0]       lat;
    branch_type_e           br_type;
    uop_flags_t             flags;
  } uop_ctrl_t;

  // ===========================================================================
  // 12. Pipeline Transaction Packets
  // ===========================================================================

  // --- Dependency / Scheduling Metadata --------------------------------------
  typedef struct packed {
    logic [NUM_SRC-1:0]     src_rdy;
    logic [NUM_SRC-1:0]     src_ld_spec;    // woken by speculative load hit
    ld_spec_mask_t          ld_dep;
    logic                   ssid_valid;
    logic [SSID_W-1:0]      ssid;
    logic                   wait_store;
    stq_id_t                wait_stq;
  } dep_meta_t;

  // --- Fetch -----------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic [ILEN-1:0]        instr;
    branch_type_e           pd_br_type;     // predecode classification
  } fetch_slot_t;

  typedef struct packed {
    logic                               valid;
    vaddr_t                             pc;           // fetch-block base
    logic [FTQ_IDX_W-1:0]               ftq_idx;
    fetch_slot_t [FETCH_WIDTH-1:0]      slot;
    logic                               pred_taken;
    logic [FETCH_SLOT_W-1:0]            pred_slot;
    vaddr_t                             pred_target;
    bp_meta_t                           bp_meta;
    exc_meta_t                          exc;
  } fetch_pkt_t;

  // --- Decode ----------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    vaddr_t                 pc;
    instr_t                 instr;
    ftq_ref_t               ftq;
    uop_ctrl_t              ctrl;
    areg_t                  rs1;
    areg_t                  rs2;
    areg_t                  rs3;
    areg_t                  rd;
    imm_t                   imm;
    bp_slot_pred_t          pred;
    exc_meta_t              exc;
  } decode_pkt_t;

  // --- Rename ----------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    ftq_ref_t               ftq;
    uop_ctrl_t              ctrl;
    areg_t                  ard;
    preg_t                  prs1;
    preg_t                  prs2;
    preg_t                  prs3;
    preg_t                  prd;
    preg_t                  stale_prd;
    dep_meta_t              dep;
    rob_id_t                rob_id;
    ldq_id_t                ldq_id;
    stq_id_t                stq_id;
    br_tag_t                br_tag;
    br_mask_t               br_mask;
    imm_t                   imm;
    bp_slot_pred_t          pred;
    vcfg_t                  vcfg;
    exc_meta_t              exc;
  } rename_pkt_t;

  // --- Issue -----------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    exec_ctrl_t             ctrl;
    lat_class_e             lat_class;
    logic [LAT_W-1:0]       lat;
    preg_t                  prs1;
    preg_t                  prs2;
    preg_t                  prs3;
    preg_t                  prd;
    dep_meta_t              dep;
    rob_id_t                rob_id;
    ldq_id_t                ldq_id;
    stq_id_t                stq_id;
    br_tag_t                br_tag;
    br_mask_t               br_mask;
    imm_t                   imm;
    ftq_ref_t               ftq;
    bp_slot_pred_t          pred;
    vcfg_t                  vcfg;
  } issue_pkt_t;

  // --- Execute (post register read / bypass) ---------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   spec;           // dependent on unconfirmed load
    exec_ctrl_t             ctrl;
    vaddr_t                 pc;
    xlen_t                  rs1_data;
    xlen_t                  rs2_data;
    xlen_t                  rs3_data;
    imm_t                   imm;
    preg_t                  prd;
    rob_id_t                rob_id;
    ldq_id_t                ldq_id;
    stq_id_t                stq_id;
    br_tag_t                br_tag;
    br_mask_t               br_mask;
    ftq_ref_t               ftq;
    bp_slot_pred_t          pred;
    vcfg_t                  vcfg;
  } exec_pkt_t;

  // --- Writeback -------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   rd_en;
    logic                   spec;
    logic                   replay;
    preg_t                  prd;
    xlen_t                  data;
    rob_id_t                rob_id;
    br_mask_t               br_mask;
    fflags_t                fflags;
    logic                   fflags_en;
    exc_meta_t              exc;
    xlen_t                  tval;
  } wb_pkt_t;

  // --- Branch Resolution -----------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   mispredict;
    logic                   taken;
    branch_type_e           br_type;
    br_tag_t                br_tag;
    br_mask_t               br_mask;
    rob_id_t                rob_id;
    ftq_ref_t               ftq;
    vaddr_t                 target;
  } br_resolve_t;

  // --- Front-End Redirect ----------------------------------------------------
  typedef enum logic [2:0] {
    RDR_NONE        = 3'd0,
    RDR_BR_MISPRED  = 3'd1,
    RDR_EXCEPTION   = 3'd2,
    RDR_INTERRUPT   = 3'd3,
    RDR_XRET        = 3'd4,
    RDR_FENCE_I     = 3'd5,
    RDR_MEM_ORDER   = 3'd6,
    RDR_SERIALIZE   = 3'd7
  } redirect_src_e;

  typedef struct packed {
    logic                   valid;
    redirect_src_e          src;
    vaddr_t                 target;
    ftq_ref_t               ftq;
    rob_id_t                rob_id;
    br_mask_t               kill_mask;
  } redirect_t;

  // --- Reorder Buffer --------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   done;
    logic                   rd_en;
    areg_t                  ard;
    preg_t                  prd;
    preg_t                  stale_prd;
    ftq_ref_t               ftq;
    uop_flags_t             flags;
    branch_type_e           br_type;
    logic                   br_taken;
    fflags_t                fflags;
    exc_meta_t              exc;
  } rob_entry_t;

  // --- Commit ----------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   rd_en;
    rob_id_t                rob_id;
    ftq_ref_t               ftq;
    areg_t                  ard;
    preg_t                  prd;
    preg_t                  stale_prd;
    logic                   is_load;
    logic                   is_store;
    branch_type_e           br_type;
    logic                   br_taken;
    fflags_t                fflags;
    logic                   fflags_en;
  } commit_slot_t;

  typedef struct packed {
    commit_slot_t [COMMIT_WIDTH-1:0] slot;
    trap_info_t                      trap;
  } commit_pkt_t;

  // --- Tensor Command (issued from ROB head, non-speculative) ----------------
  typedef struct packed {
    logic                   valid;
    tensor_op_e             op;
    tns_form_e              form;
    tensor_dtype_e          dtype;
    logic                   acc;
    logic [TILE_IDX_W-1:0]  td;
    logic [TILE_IDX_W-1:0]  ts1;
    logic [TILE_IDX_W-1:0]  ts2;
    xlen_t                  base;
    xlen_t                  stride;
    rob_id_t                rob_id;
    priv_mode_t             priv;
    logic [ASID_W-1:0]      asid;
  } tensor_cmd_t;

  // ===========================================================================
  // 13. Memory Subsystem
  // ===========================================================================

  // --- L1 Operation Codes ----------------------------------------------------
  typedef enum logic [3:0] {
    COP_LOAD        = 4'd0,
    COP_STORE       = 4'd1,
    COP_AMO         = 4'd2,
    COP_LR          = 4'd3,
    COP_SC          = 4'd4,
    COP_PREF_R      = 4'd5,
    COP_PREF_W      = 4'd6,
    COP_CBO_CLEAN   = 4'd7,
    COP_CBO_FLUSH   = 4'd8,
    COP_CBO_INVAL   = 4'd9,
    COP_CBO_ZERO    = 4'd10
  } cache_op_e;

  typedef enum logic [1:0] {
    DCS_HIT         = 2'd0,
    DCS_MISS        = 2'd1,     // MSHR allocated; wakeup on refill
    DCS_NACK        = 2'd2,     // bank / MSHR conflict; replay required
    DCS_ERR         = 2'd3
  } dcache_status_e;

  typedef enum logic [1:0] {
    PBMT_PMA        = 2'd0,
    PBMT_NC         = 2'd1,
    PBMT_IO         = 2'd2
  } pbmt_e;

  typedef struct packed {
    logic                   is_store;
    logic [LSQ_IDX_W-1:0]   idx;
  } lsq_tag_t;

  // --- Instruction Cache -----------------------------------------------------
  typedef struct packed {
    logic                   valid;
    vaddr_t                 vaddr;
    logic [FTQ_IDX_W-1:0]   ftq_idx;
    priv_mode_t             priv;
  } icache_req_t;

  typedef struct packed {
    logic                       valid;
    logic [FTQ_IDX_W-1:0]       ftq_idx;
    logic [FETCH_BYTES*8-1:0]   data;
    ecc_status_e                ecc;
    exc_meta_t                  exc;
  } icache_rsp_t;

  // --- Data Cache ------------------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   spec;
    cache_op_e              op;
    mem_size_e              size;
    amo_op_e                amo;
    paddr_t                 paddr;          // index bits identical to VA
    xlen_t                  data;
    logic [XLEN_BYTES-1:0]  be;
    lsq_tag_t               tag;
    rob_id_t                rob_id;
    pbmt_e                  pbmt;
    priv_mode_t             priv;
  } dcache_req_t;

  typedef struct packed {
    logic                   valid;
    dcache_status_e         status;
    lsq_tag_t               tag;
    xlen_t                  data;
    logic [MSHR_IDX_W-1:0]  mshr_idx;
    ecc_status_e            ecc;
  } dcache_rsp_t;

  // --- Coherence (MOESI, directory-backed L2) --------------------------------
  typedef enum logic [2:0] {
    COH_I           = 3'd0,
    COH_S           = 3'd1,
    COH_E           = 3'd2,
    COH_O           = 3'd3,
    COH_M           = 3'd4
  } coh_state_e;

  typedef enum logic [2:0] {
    CREQ_GET_S      = 3'd0,
    CREQ_GET_M      = 3'd1,
    CREQ_UPGRADE    = 3'd2,
    CREQ_PUT_S      = 3'd3,
    CREQ_PUT_E      = 3'd4,
    CREQ_PUT_O      = 3'd5,
    CREQ_PUT_M      = 3'd6
  } coh_req_e;

  typedef enum logic [2:0] {
    CGNT_S          = 3'd0,
    CGNT_E          = 3'd1,
    CGNT_M          = 3'd2,
    CGNT_UPGRADE    = 3'd3,     // ownership without data
    CGNT_PUT_ACK    = 3'd4
  } coh_grant_e;

  typedef enum logic [1:0] {
    SNP_TO_S        = 2'd0,
    SNP_TO_I        = 2'd1,
    SNP_CLEAN       = 2'd2,
    SNP_PEEK        = 2'd3
  } snp_op_e;

  typedef enum logic [TXN_SRC_W-1:0] {
    TSRC_ICACHE     = 2'd0,
    TSRC_DCACHE     = 2'd1,
    TSRC_PTW        = 2'd2,
    TSRC_ACCEL      = 2'd3
  } txn_src_e;

  typedef struct packed {
    logic [CORE_ID_W-1:0]   core;
    txn_src_e               src;
    logic [MSHR_IDX_W-1:0]  slot;
  } txn_id_t;

  typedef struct packed {
    coh_state_e             state;
    logic [NUM_CORES-1:0]   sharers;
    logic                   owner_valid;
    logic [CORE_ID_W-1:0]   owner;
  } coh_meta_t;

  typedef struct packed {
    logic                   valid;
    txn_id_t                txn_id;
    coh_req_e               op;
    line_addr_t             line_addr;
    logic                   has_data;
    cl_data_t               data;
  } cl_req_t;

  typedef struct packed {
    logic                   valid;
    txn_id_t                txn_id;
    coh_grant_e             grant;
    logic                   has_data;
    cl_data_t               data;
    ecc_status_e            ecc;
    logic                   err;
  } cl_rsp_t;

  typedef struct packed {
    logic                   valid;
    txn_id_t                txn_id;
    snp_op_e                op;
    line_addr_t             line_addr;
  } snoop_req_t;

  typedef struct packed {
    logic                   valid;
    txn_id_t                txn_id;
    logic                   hit;
    logic                   dirty;
    coh_state_e             final_state;
    cl_data_t               data;
  } snoop_rsp_t;

  typedef struct packed {
    logic                   valid;
    line_addr_t             line_addr;
    coh_req_e               req;
    coh_state_e             tgt_state;
    logic                   refill_done;
    logic                   wb_pending;
    logic [LDQ_DEPTH-1:0]   ld_waiters;
  } mshr_entry_t;

  // --- Translation -----------------------------------------------------------
  typedef enum logic [1:0] {
    PG_4K           = 2'd0,
    PG_2M           = 2'd1,
    PG_1G           = 2'd2,
    PG_512G         = 2'd3
  } pg_size_e;

  typedef struct packed {
    logic                   n;
    pbmt_e                  pbmt;
    logic [6:0]             reserved;
    logic [PPN_W-1:0]       ppn;
    logic [1:0]             rsw;
    logic                   d;
    logic                   a;
    logic                   g;
    logic                   u;
    logic                   x;
    logic                   w;
    logic                   r;
    logic                   v;
  } pte_t;

  typedef struct packed {
    logic                   valid;
    logic                   virt;
    logic [VPN_W-1:0]       vpn;
    logic [PPN_W-1:0]       ppn;
    logic [ASID_W-1:0]      asid;
    logic [VMID_W-1:0]      vmid;
    pg_size_e               pg_size;
    pbmt_e                  pbmt;
    logic                   g;
    logic                   u;
    logic                   x;
    logic                   w;
    logic                   r;
    logic                   a;
    logic                   d;
  } tlb_entry_t;

  typedef struct packed {
    logic                   valid;
    vaddr_t                 vaddr;
    access_type_e           acc;
    priv_mode_t             priv;
    logic                   sum;
    logic                   mxr;
    logic [ASID_W-1:0]      asid;
    logic [VMID_W-1:0]      vmid;
  } tlb_req_t;

  typedef struct packed {
    logic                   valid;
    logic                   hit;
    paddr_t                 paddr;
    pbmt_e                  pbmt;
    logic                   cacheable;
    exc_meta_t              exc;
  } tlb_rsp_t;

  typedef struct packed {
    logic                   valid;
    logic                   g_stage;
    logic [VPN_W-1:0]       vpn;
    access_type_e           acc;
    logic [ASID_W-1:0]      asid;
    logic [VMID_W-1:0]      vmid;
  } ptw_req_t;

  typedef struct packed {
    logic                   valid;
    logic                   g_stage;
    pte_t                   pte;
    pg_size_e               pg_size;
    logic [GPADDR_W-1:0]    gpa;
    exc_meta_t              exc;
  } ptw_rsp_t;

  // --- Load / Store Queues ---------------------------------------------------
  typedef struct packed {
    logic                   valid;
    logic                   addr_valid;
    logic                   addr_virt;      // translation outstanding
    paddr_t                 paddr;
    mem_size_e              size;
    logic                   sext;
    logic                   is_fp;
    rob_id_t                rob_id;
    preg_t                  prd;
    br_mask_t               br_mask;
    stq_id_t                stq_snap;       // youngest older store at dispatch
    logic                   executed;
    logic                   succeeded;
    logic                   fwd_valid;
    stq_id_t                fwd_stq;
    logic                   order_fail;
    logic                   observed;       // snoop hit after execution
    exc_meta_t              exc;
  } ldq_entry_t;

  typedef struct packed {
    logic                   valid;
    logic                   addr_valid;
    logic                   addr_virt;
    paddr_t                 paddr;
    mem_size_e              size;
    logic                   data_valid;
    xlen_t                  data;
    rob_id_t                rob_id;
    br_mask_t               br_mask;
    logic                   committed;
    logic                   succeeded;
    logic                   is_amo;
    amo_op_e                amo;
    logic                   is_fence;
    exc_meta_t              exc;
  } stq_entry_t;

  // --- System Interconnect (AXI4) --------------------------------------------
  typedef enum logic [1:0] {
    AXI_BURST_FIXED = 2'b00,
    AXI_BURST_INCR  = 2'b01,
    AXI_BURST_WRAP  = 2'b10
  } axi_burst_e;

  typedef enum logic [1:0] {
    AXI_RESP_OKAY   = 2'b00,
    AXI_RESP_EXOKAY = 2'b01,
    AXI_RESP_SLVERR = 2'b10,
    AXI_RESP_DECERR = 2'b11
  } axi_resp_e;

  typedef struct packed {
    logic [AXI_ID_W-1:0]     id;
    logic [AXI_ADDR_W-1:0]   addr;
    logic [AXI_LEN_W-1:0]    len;
    logic [AXI_SIZE_W-1:0]   size;
    axi_burst_e              burst;
    logic                    lock;
    logic [AXI_CACHE_W-1:0]  cache;
    logic [AXI_PROT_W-1:0]   prot;
    logic [AXI_QOS_W-1:0]    qos;
    logic [AXI_REGION_W-1:0] region;
    logic [AXI_USER_W-1:0]   user;
  } axi_ax_t;

  typedef struct packed {
    logic [AXI_DATA_W-1:0]   data;
    logic [AXI_STRB_W-1:0]   strb;
    logic                    last;
    logic [AXI_USER_W-1:0]   user;
  } axi_w_t;

  typedef struct packed {
    logic [AXI_ID_W-1:0]     id;
    axi_resp_e               resp;
    logic [AXI_USER_W-1:0]   user;
  } axi_b_t;

  typedef struct packed {
    logic [AXI_ID_W-1:0]     id;
    logic [AXI_DATA_W-1:0]   data;
    axi_resp_e               resp;
    logic                    last;
    logic [AXI_USER_W-1:0]   user;
  } axi_r_t;

  typedef struct packed {
    axi_ax_t                 aw;
    logic                    aw_valid;
    axi_w_t                  w;
    logic                    w_valid;
    logic                    b_ready;
    axi_ax_t                 ar;
    logic                    ar_valid;
    logic                    r_ready;
  } axi_req_t;

  typedef struct packed {
    logic                    aw_ready;
    logic                    w_ready;
    axi_b_t                  b;
    logic                    b_valid;
    logic                    ar_ready;
    axi_r_t                  r;
    logic                    r_valid;
  } axi_rsp_t;

  // ===========================================================================
  // 14. Utility Types
  // ===========================================================================

  typedef logic [PRF_INT_REGS-1:0] sb_int_t;
  typedef logic [PRF_FP_REGS-1:0]  sb_fp_t;
  typedef logic [PRF_VEC_REGS-1:0] sb_vec_t;
  typedef logic [TILE_REGS-1:0]    sb_tile_t;
  typedef logic [ROB_DEPTH-1:0]    rob_mask_t;
  typedef logic [ISSUE_WIDTH-1:0]  issue_mask_t;
  typedef logic [COMMIT_WIDTH-1:0] commit_mask_t;

  // Stall / hazard reason vector; also the source of front/back-end PMU events.
  typedef struct packed {
    logic                   raw;
    logic                   waw;
    logic                   war;
    logic                   structural;
    logic                   mem_order;
    logic                   store_set;
    logic                   serialize;
    logic                   csr;
    logic                   fence;
    logic                   rob_full;
    logic                   iq_full;
    logic                   ldq_full;
    logic                   stq_full;
    logic                   prf_empty;
    logic                   br_tag_empty;
    logic                   redirect;
  } hazard_t;

  // ===========================================================================
  // 15. Utility Constants and Functions
  // ===========================================================================

  localparam logic [ILEN-1:0] SF_INSTR_NOP     = 32'h0000_0013;   // addi x0,x0,0
  localparam logic [ILEN-1:0] SF_INSTR_ILLEGAL = 32'h0000_0000;
  localparam vaddr_t          SF_RESET_PC      = 48'h0000_8000_0000;
  localparam vaddr_t          SF_NMI_VECTOR    = 48'h0000_0000_1000;
  localparam vaddr_t          SF_DEBUG_ROM     = 48'h0000_0000_0800;

  localparam br_mask_t        BR_MASK_NONE     = '0;
  localparam exc_meta_t       EXC_META_NONE    = '{valid:  1'b0,
                                                   cause:  EXC_IADDR_MISALIGNED,
                                                   fclass: FLT_NONE};
  localparam preg_t           PREG_NONE        = '{rf: RF_NONE, idx: '0};
  localparam areg_t           AREG_NONE        = '{rf: RF_NONE, idx: '0};

  // a strictly older than b in program order.
  function automatic logic rob_older(input rob_id_t a, input rob_id_t b);
    return (a.wrap == b.wrap) ? (a.idx < b.idx) : (a.idx > b.idx);
  endfunction

  function automatic logic stq_older(input stq_id_t a, input stq_id_t b);
    return (a.wrap == b.wrap) ? (a.idx < b.idx) : (a.idx > b.idx);
  endfunction

  function automatic logic ldq_older(input ldq_id_t a, input ldq_id_t b);
    return (a.wrap == b.wrap) ? (a.idx < b.idx) : (a.idx > b.idx);
  endfunction

  function automatic br_mask_t br_tag_to_mask(input br_tag_t tag);
    return br_mask_t'(1) << tag;
  endfunction

  function automatic logic br_killed(input br_mask_t mask, input br_mask_t kill);
    return |(mask & kill);
  endfunction

  function automatic br_mask_t br_resolve(input br_mask_t mask, input br_mask_t clr);
    return mask & ~clr;
  endfunction

  function automatic vaddr_t slot_pc(input vaddr_t                  block_pc,
                                     input logic [FETCH_SLOT_W-1:0] slot);
    return {block_pc[VADDR_W-1:FETCH_OFF_W], slot, {INSTR_OFF_W{1'b0}}};
  endfunction

  function automatic logic [XLEN_BYTES-1:0] mem_byte_en(
      input logic [XLEN_OFF_W-1:0] off,
      input mem_size_e             size);
    logic [XLEN_BYTES-1:0] base;
    case (size)
      MSZ_B:   base = XLEN_BYTES'({1{1'b1}});
      MSZ_H:   base = XLEN_BYTES'({2{1'b1}});
      MSZ_W:   base = XLEN_BYTES'({4{1'b1}});
      default: base = '1;
    endcase
    return base << off;
  endfunction

  function automatic logic mem_misaligned(input logic [CL_OFFSET_W-1:0] off,
                                          input mem_size_e              size);
    logic [CL_OFFSET_W-1:0] mask;
    mask = (CL_OFFSET_W'(1'b1) << size) - CL_OFFSET_W'(1'b1);
    return |(off & mask);
  endfunction

  function automatic imm_t imm_gen(input instr_t instr, input imm_fmt_e fmt);
    imm_t imm;
    case (fmt)
      IMM_I:   imm = {{(IMM_W-IMM_I_W){instr.i.imm[IMM_I_W-1]}}, instr.i.imm};
      IMM_S:   imm = {{(IMM_W-IMM_I_W){instr.s.imm_hi[6]}},
                      instr.s.imm_hi, instr.s.imm_lo};
      IMM_B:   imm = {{(IMM_W-13){instr.b.imm12}}, instr.b.imm12, instr.b.imm11,
                      instr.b.imm10_5, instr.b.imm4_1, 1'b0};
      IMM_U:   imm = {instr.u.imm, {(IMM_W-IMM_U_W){1'b0}}};
      IMM_J:   imm = {{(IMM_W-21){instr.j.imm20}}, instr.j.imm20, instr.j.imm19_12,
                      instr.j.imm11, instr.j.imm10_1, 1'b0};
      IMM_Z:   imm = {{(IMM_W-AREG_W){1'b0}}, instr.i.rs1};
      IMM_V:   imm = {{(IMM_W-AREG_W){instr.v.vs1[AREG_W-1]}}, instr.v.vs1};
      default: imm = '0;
    endcase
    return imm;
  endfunction

  function automatic xlen_t mcause_encode(input trap_info_t trap);
    return {trap.is_irq, {(XLEN-1-CAUSE_W){1'b0}}, trap.cause.raw};
  endfunction

  function automatic logic is_xret(input uop_ctrl_t ctrl);
    return (ctrl.exe.op_class == OPC_SYSTEM) &&
           ((ctrl.exe.func.sys == SYS_SRET) ||
            (ctrl.exe.func.sys == SYS_MRET) ||
            (ctrl.exe.func.sys == SYS_DRET));
  endfunction

endpackage : silicaflux_pkg
