// =============================================================================
//  SilicaFlux Compute Architecture
// -----------------------------------------------------------------------------
//  File        : silicaflux_pkg.sf
//  Language    : Silica Flux-2017
//  Description : Architectural contract shared by RTL, verification, firmware
//                and physical design. Defines global sizing, the SFX-32 ISA
//                encoding hierarchy, micro-op taxonomy, pipeline transaction
//                structures, memory-system / coherence / AXI channel payloads,
//                trap metadata, observability records and common utilities.
//
//  Conventions :
//    * Handshaked channels carry valid/ready as discrete ports; payload
//      structs below never embed handshake state.
//    * Unidirectional event buses (redirects, training, snoop proxy events)
//      embed a 'valid' qualifier as the first field.
//    * All address / data fields are unsigned. Sign is conveyed explicitly
//      through dedicated qualifier bits, never through declaration.
//    * Enum encodings marked ARCH are architecturally visible and frozen.
// =============================================================================

package silicaflux_pkg;

  // ===========================================================================
  // 1. Architecture Identification                                      [ARCH]
  // ===========================================================================

  localparam logic [15:0] SF_ARCH_VENDOR   = 16'h5F1C;
  localparam logic [7:0]  SF_ARCH_MAJOR    = 8'd2;
  localparam logic [7:0]  SF_ARCH_MINOR    = 8'd1;
  localparam logic [31:0] SF_ARCH_REVISION = {SF_ARCH_VENDOR, SF_ARCH_MAJOR, SF_ARCH_MINOR};

  // ===========================================================================
  // 2. Global Architectural Parameters
  // ===========================================================================

  // ---- Datapath ---------------------------------------------------------------
  localparam int unsigned XLEN            = 64;
  localparam int unsigned FLEN            = 64;
  localparam int unsigned ILEN            = 32;
  localparam int unsigned XLEN_BYTES      = XLEN / 8;
  localparam int unsigned INSTR_BYTES     = ILEN / 8;
  localparam int unsigned INSTR_OFF_W     = $clog2(INSTR_BYTES);
  localparam int unsigned IMM_W           = 32;
  localparam int unsigned FFLAGS_W        = 5;

  // ---- Virtual memory ---------------------------------------------------------
  localparam int unsigned VADDR_W         = 48;
  localparam int unsigned PADDR_W         = 52;
  localparam int unsigned PAGE_OFF_W      = 12;
  localparam int unsigned VPN_W           = VADDR_W - PAGE_OFF_W;
  localparam int unsigned PPN_W           = PADDR_W - PAGE_OFF_W;
  localparam int unsigned PT_LEVELS       = 4;
  localparam int unsigned VPN_SEG_W       = 9;
  localparam int unsigned PTE_PPN_W       = 44;
  localparam int unsigned ASID_W          = 16;
  localparam int unsigned VMID_W          = 14;

  // ---- Frontend ---------------------------------------------------------------
  localparam int unsigned FETCH_WIDTH     = 4;
  localparam int unsigned FETCH_BYTES     = FETCH_WIDTH * INSTR_BYTES;
  localparam int unsigned FETCH_BITS      = FETCH_BYTES * 8;
  localparam int unsigned FETCH_OFF_W     = $clog2(FETCH_BYTES);
  localparam int unsigned FETCH_LANE_W    = $clog2(FETCH_WIDTH);
  localparam int unsigned FETCH_CNT_W     = $clog2(FETCH_WIDTH + 1);
  localparam int unsigned FETCH_INFLIGHT  = 8;
  localparam int unsigned FETCH_TAG_W     = $clog2(FETCH_INFLIGHT);
  localparam int unsigned FETCH_BUF_DEPTH = 8;
  localparam int unsigned FETCH_SEQ_W     = 16;

  // ---- Branch prediction ------------------------------------------------------
  localparam int unsigned GHIST_W         = 64;
  localparam int unsigned RAS_DEPTH       = 32;
  localparam int unsigned RAS_PTR_W       = $clog2(RAS_DEPTH);
  localparam int unsigned BP_CONF_W       = 2;
  localparam int unsigned BTB_WAYS        = 4;
  localparam int unsigned BTB_SETS        = 1024;
  localparam int unsigned BTB_SET_W       = $clog2(BTB_SETS);
  localparam int unsigned BTB_TAG_W       = VADDR_W - FETCH_OFF_W - BTB_SET_W;

  // ---- Out-of-order backend ---------------------------------------------------
  localparam int unsigned DECODE_WIDTH    = 4;
  localparam int unsigned DECODE_CNT_W    = $clog2(DECODE_WIDTH + 1);
  localparam int unsigned RENAME_WIDTH    = 4;
  localparam int unsigned DISPATCH_WIDTH  = 4;
  localparam int unsigned ISSUE_WIDTH     = 8;
  localparam int unsigned WB_WIDTH        = 8;
  localparam int unsigned COMMIT_WIDTH    = 4;

  localparam int unsigned NUM_AREGS       = 32;
  localparam int unsigned AREG_W          = $clog2(NUM_AREGS);
  localparam int unsigned NUM_INT_PREGS   = 192;
  localparam int unsigned NUM_FP_PREGS    = 160;
  localparam int unsigned NUM_VEC_PREGS   = 64;
  localparam int unsigned PREG_W          = $clog2(NUM_INT_PREGS);

  localparam int unsigned ROB_DEPTH       = 256;
  localparam int unsigned ROB_IDX_W       = $clog2(ROB_DEPTH);
  localparam int unsigned LDQ_DEPTH       = 64;
  localparam int unsigned LDQ_IDX_W       = $clog2(LDQ_DEPTH);
  localparam int unsigned STQ_DEPTH       = 48;
  localparam int unsigned STQ_IDX_W       = $clog2(STQ_DEPTH);
  localparam int unsigned MAX_BR_TAGS     = 16;
  localparam int unsigned BR_TAG_W        = $clog2(MAX_BR_TAGS);
  localparam int unsigned UOP_OP_W        = 6;

  // ---- Vector / tensor extensions ---------------------------------------------
  localparam int unsigned VLEN            = 512;
  localparam int unsigned ELEN            = 64;
  localparam int unsigned VLEN_BYTES      = VLEN / 8;
  localparam int unsigned VLANES          = VLEN / ELEN;
  localparam int unsigned VL_W            = $clog2(VLEN_BYTES + 1);
  localparam int unsigned NUM_VREGS       = 32;
  localparam int unsigned TNS_TILE_DIM    = 16;
  localparam int unsigned TNS_DIM_W       = $clog2(TNS_TILE_DIM + 1);
  localparam int unsigned TNS_NUM_TREGS   = 8;
  localparam int unsigned TREG_W          = $clog2(TNS_NUM_TREGS);

  // ---- Memory hierarchy -------------------------------------------------------
  localparam int unsigned CL_BYTES        = 64;
  localparam int unsigned CL_W            = CL_BYTES * 8;
  localparam int unsigned CL_OFF_W        = $clog2(CL_BYTES);
  localparam int unsigned LINE_ADDR_W     = PADDR_W - CL_OFF_W;
  localparam int unsigned DC_TXN_W        = 6;
  localparam int unsigned MEM_TAG_W       = 6;

  // ---- Cluster fabric ---------------------------------------------------------
  localparam int unsigned MAX_CORES       = 16;
  localparam int unsigned CORE_ID_W       = $clog2(MAX_CORES);
  localparam int unsigned MAX_LLC_BANKS   = 16;
  localparam int unsigned BANK_ID_W       = $clog2(MAX_LLC_BANKS);
  localparam int unsigned MAX_MEM_PORTS   = 4;
  localparam int unsigned NODE_ID_W       = CORE_ID_W + 1;
  localparam int unsigned TXN_ID_W        = 8;
  localparam int unsigned SNP_ID_W        = 6;
  localparam int unsigned QOS_W           = 4;
  localparam int unsigned ARB_MAX_W       = 32;
  localparam int unsigned ARB_IDX_W       = $clog2(ARB_MAX_W);
  localparam logic [ARB_MAX_W-1:0] ARB_ONE = {{(ARB_MAX_W-1){1'b0}}, 1'b1};

  // ---- AXI edge ---------------------------------------------------------------
  localparam int unsigned AXI_ADDR_W      = PADDR_W;
  localparam int unsigned AXI_DATA_W      = 256;
  localparam int unsigned AXI_STRB_W      = AXI_DATA_W / 8;
  localparam int unsigned AXI_ID_W        = 8;
  localparam int unsigned AXI_USER_W      = 8;
  localparam int unsigned AXI_LEN_W       = 8;
  localparam int unsigned AXI_BEATS_PER_CL = CL_W / AXI_DATA_W;

  // ---- Host control / debug / observability -----------------------------------
  localparam int unsigned APB_ADDR_W      = 24;
  localparam int unsigned APB_DATA_W      = 32;
  localparam int unsigned APB_STRB_W      = APB_DATA_W / 8;
  localparam int unsigned DMI_ADDR_W      = 7;
  localparam int unsigned DMI_DATA_W      = 32;
  localparam int unsigned DBG_REGNO_W     = 16;
  localparam int unsigned TS_W            = 48;
  localparam int unsigned FAULT_UNIT_W    = 5;
  localparam int unsigned PERF_CNT_W      = 48;

  // ===========================================================================
  // 3. Primitive Typedefs
  // ===========================================================================

  typedef logic [XLEN-1:0]          xlen_t;
  typedef logic [FLEN-1:0]          flen_t;
  typedef logic [ILEN-1:0]          instr_t;
  typedef logic [IMM_W-1:0]         imm_t;
  typedef logic [VADDR_W-1:0]       vaddr_t;
  typedef logic [PADDR_W-1:0]       paddr_t;
  typedef logic [LINE_ADDR_W-1:0]   line_addr_t;
  typedef logic [VPN_W-1:0]         vpn_t;
  typedef logic [PPN_W-1:0]         ppn_t;
  typedef logic [ASID_W-1:0]        asid_t;
  typedef logic [VMID_W-1:0]        vmid_t;

  typedef logic [AREG_W-1:0]        areg_t;
  typedef logic [PREG_W-1:0]        preg_t;
  typedef logic [ROB_IDX_W-1:0]     rob_idx_t;
  typedef logic [LDQ_IDX_W-1:0]     ldq_idx_t;
  typedef logic [STQ_IDX_W-1:0]     stq_idx_t;
  typedef logic [BR_TAG_W-1:0]      br_tag_t;
  typedef logic [MAX_BR_TAGS-1:0]   br_mask_t;

  typedef logic [GHIST_W-1:0]       ghist_t;
  typedef logic [RAS_PTR_W-1:0]     ras_ptr_t;
  typedef logic [BP_CONF_W-1:0]     bp_conf_t;
  typedef logic [FETCH_TAG_W-1:0]   fetch_tag_t;
  typedef logic [FETCH_LANE_W-1:0]  fetch_lane_t;
  typedef logic [FETCH_WIDTH-1:0]   fetch_mask_t;
  typedef logic [FETCH_SEQ_W-1:0]   fetch_seq_t;

  typedef logic [CL_W-1:0]          cl_data_t;
  typedef logic [CL_BYTES-1:0]      cl_be_t;
  typedef logic [DC_TXN_W-1:0]      dc_txn_t;

  typedef logic [CORE_ID_W-1:0]     core_id_t;
  typedef logic [MAX_CORES-1:0]     core_mask_t;
  typedef logic [BANK_ID_W-1:0]     bank_id_t;
  typedef logic [NODE_ID_W-1:0]     node_id_t;
  typedef logic [TXN_ID_W-1:0]      txn_id_t;
  typedef logic [SNP_ID_W-1:0]      snp_id_t;
  typedef logic [QOS_W-1:0]         qos_t;

  typedef logic [VLEN-1:0]          vreg_t;
  typedef logic [VLEN_BYTES-1:0]    vbyte_mask_t;
  typedef logic [VLANES-1:0]        vlane_mask_t;
  typedef logic [VL_W-1:0]          vl_t;
  typedef logic [TREG_W-1:0]        treg_t;

  typedef logic [TS_W-1:0]          timestamp_t;

  // Physical register scoreboards (one busy bit per physical register).
  typedef logic [NUM_INT_PREGS-1:0] int_sb_t;
  typedef logic [NUM_FP_PREGS-1:0]  fp_sb_t;
  typedef logic [NUM_VEC_PREGS-1:0] vec_sb_t;

  // ---- Node identity map --------------------------------------------------------
  // Cores occupy node IDs [0, MAX_CORES); IO requesters follow.
  localparam node_id_t NODE_ID_IO_BASE = node_id_t'(MAX_CORES);
  localparam node_id_t NODE_ID_DMA     = NODE_ID_IO_BASE;

  // ---- Architectural register aliases ------------------------------------------
  localparam areg_t AREG_ZERO     = areg_t'(0);
  localparam areg_t AREG_RA       = areg_t'(1);
  localparam areg_t AREG_SP       = areg_t'(2);
  localparam areg_t AREG_ALT_LINK = areg_t'(5);

  // ===========================================================================
  // 4. Privilege, Pipeline and Execution Taxonomy
  // ===========================================================================

  typedef enum logic [1:0] {                                          // [ARCH]
    PRIV_U = 2'b00,
    PRIV_S = 2'b01,
    PRIV_H = 2'b10,
    PRIV_M = 2'b11
  } priv_e;

  typedef enum logic [3:0] {
    STG_F0_PCGEN  = 4'd0,
    STG_F1_PRED   = 4'd1,
    STG_F2_ALIGN  = 4'd2,
    STG_DECODE    = 4'd3,
    STG_RENAME    = 4'd4,
    STG_DISPATCH  = 4'd5,
    STG_ISSUE     = 4'd6,
    STG_REGREAD   = 4'd7,
    STG_EXECUTE   = 4'd8,
    STG_MEMORY    = 4'd9,
    STG_WRITEBACK = 4'd10,
    STG_COMMIT    = 4'd11
  } pipe_stage_e;

  typedef enum logic [3:0] {
    FU_NONE = 4'd0,
    FU_ALU  = 4'd1,
    FU_MUL  = 4'd2,
    FU_DIV  = 4'd3,
    FU_BRU  = 4'd4,
    FU_LSU  = 4'd5,
    FU_CSR  = 4'd6,
    FU_FPU  = 4'd7,
    FU_FDIV = 4'd8,
    FU_VEC  = 4'd9,
    FU_VLSU = 4'd10,
    FU_TNS  = 4'd11
  } fu_type_e;

  typedef enum logic [1:0] {
    RC_NONE = 2'd0,
    RC_INT  = 2'd1,
    RC_FP   = 2'd2,
    RC_VEC  = 2'd3
  } reg_class_e;

  typedef enum logic [1:0] {
    OPND_REG  = 2'd0,
    OPND_IMM  = 2'd1,
    OPND_PC   = 2'd2,
    OPND_ZERO = 2'd3
  } opnd_sel_e;

  typedef enum logic [2:0] {
    IMM_NONE = 3'd0,
    IMM_I    = 3'd1,
    IMM_S    = 3'd2,
    IMM_B    = 3'd3,
    IMM_U    = 3'd4,
    IMM_J    = 3'd5,
    IMM_Z    = 3'd6,
    IMM_V5   = 3'd7
  } imm_fmt_e;

  typedef enum logic [2:0] {
    CFI_NONE          = 3'd0,
    CFI_BRANCH        = 3'd1,
    CFI_JUMP          = 3'd2,
    CFI_CALL          = 3'd3,
    CFI_RET           = 3'd4,
    CFI_INDIRECT      = 3'd5,
    CFI_INDIRECT_CALL = 3'd6
  } cfi_type_e;

  typedef enum logic [2:0] {
    RDR_NONE       = 3'd0,
    RDR_TRAP       = 3'd1,
    RDR_XRET       = 3'd2,
    RDR_MISPREDICT = 3'd3,
    RDR_REPLAY     = 3'd4,
    RDR_FENCE_I    = 3'd5,
    RDR_SERIALIZE  = 3'd6,
    RDR_DEBUG      = 3'd7
  } redirect_cause_e;

  // ===========================================================================
  // 5. SFX-32 Instruction Encoding                                      [ARCH]
  // ---------------------------------------------------------------------------
  //  opcode[6:0] = { group[2:0], minor[1:0], len[1:0] }
  //    len   = 2'b11 : 32-bit instruction; other values reserved for 16/48-bit.
  //    group : primary decode axis, minor : secondary format selector.
  //  Branch / jump offsets are encoded in instruction-word units (x4 bytes).
  // ===========================================================================

  localparam logic [1:0] OPC_LEN_32 = 2'b11;

  typedef enum logic [2:0] {
    OPG_INT  = 3'b000,
    OPG_INTX = 3'b001,
    OPG_MEM  = 3'b010,
    OPG_CTRL = 3'b011,
    OPG_FP   = 3'b100,
    OPG_VEC  = 3'b101,
    OPG_TNS  = 3'b110,
    OPG_SYS  = 3'b111
  } opc_group_e;

  typedef enum logic [6:0] {
    // ---- integer -----------------------------------------------------------
    OPC_ALU_R     = 7'b000_00_11,
    OPC_ALU_I     = 7'b000_01_11,
    OPC_ALU_RW    = 7'b000_10_11,
    OPC_ALU_IW    = 7'b000_11_11,
    // ---- integer extended --------------------------------------------------
    OPC_LUI       = 7'b001_00_11,
    OPC_AUIPC     = 7'b001_01_11,
    OPC_MULDIV    = 7'b001_10_11,
    OPC_BITMANIP  = 7'b001_11_11,
    // ---- memory ------------------------------------------------------------
    OPC_LOAD      = 7'b010_00_11,
    OPC_STORE     = 7'b010_01_11,
    OPC_AMO       = 7'b010_10_11,
    OPC_FENCE     = 7'b010_11_11,
    // ---- control transfer --------------------------------------------------
    OPC_BRANCH    = 7'b011_00_11,
    OPC_JAL       = 7'b011_01_11,
    OPC_JALR      = 7'b011_10_11,
    // ---- floating point ----------------------------------------------------
    OPC_FP_LOAD   = 7'b100_00_11,
    OPC_FP_STORE  = 7'b100_01_11,
    OPC_FP_OP     = 7'b100_10_11,
    OPC_FP_FMA    = 7'b100_11_11,
    // ---- vector ------------------------------------------------------------
    OPC_VEC_LOAD  = 7'b101_00_11,
    OPC_VEC_STORE = 7'b101_01_11,
    OPC_VEC_ARITH = 7'b101_10_11,
    OPC_VEC_CFG   = 7'b101_11_11,
    // ---- tensor ------------------------------------------------------------
    OPC_TNS_LOAD  = 7'b110_00_11,
    OPC_TNS_STORE = 7'b110_01_11,
    OPC_TNS_MMA   = 7'b110_10_11,
    OPC_TNS_CTRL  = 7'b110_11_11,
    // ---- system / custom ---------------------------------------------------
    OPC_SYSTEM    = 7'b111_00_11,
    OPC_CUSTOM0   = 7'b111_01_11,
    OPC_CUSTOM1   = 7'b111_10_11
  } opcode_e;

  // ---- funct3 sub-encodings ---------------------------------------------------
  typedef enum logic [2:0] {
    F3_ADD_SUB = 3'b000,
    F3_SLL     = 3'b001,
    F3_SLT     = 3'b010,
    F3_SLTU    = 3'b011,
    F3_XOR     = 3'b100,
    F3_SRL_SRA = 3'b101,
    F3_OR      = 3'b110,
    F3_AND     = 3'b111
  } alu_f3_e;

  typedef enum logic [2:0] {
    F3_BEQ  = 3'b000,
    F3_BNE  = 3'b001,
    F3_BLT  = 3'b100,
    F3_BGE  = 3'b101,
    F3_BLTU = 3'b110,
    F3_BGEU = 3'b111
  } br_f3_e;

  typedef enum logic [2:0] {
    F3_MEM_B  = 3'b000,
    F3_MEM_H  = 3'b001,
    F3_MEM_W  = 3'b010,
    F3_MEM_D  = 3'b011,
    F3_MEM_BU = 3'b100,
    F3_MEM_HU = 3'b101,
    F3_MEM_WU = 3'b110
  } mem_f3_e;

  typedef enum logic [2:0] {
    F3_PRIV   = 3'b000,
    F3_CSRRW  = 3'b001,
    F3_CSRRS  = 3'b010,
    F3_CSRRC  = 3'b011,
    F3_CSRRWI = 3'b101,
    F3_CSRRSI = 3'b110,
    F3_CSRRCI = 3'b111
  } sys_f3_e;

  localparam logic [6:0] F7_BASE = 7'b000_0000;
  localparam logic [6:0] F7_ALT  = 7'b010_0000;
  localparam logic [6:0] F7_MDU  = 7'b000_0001;
  localparam logic [6:0] F7_MDU_W        = 7'b000_0101;
  localparam logic [6:0] F7_SFENCE_VMA   = 7'b000_1001;

  // ---- Memory ordering / cache maintenance ------------------------------------
  typedef enum logic [2:0] {
    F3_FENCE    = 3'b000,
    F3_FENCE_I  = 3'b001,
    F3_CBO      = 3'b010,
    F3_PREFETCH = 3'b011
  } fence_f3_e;

  typedef enum logic [11:0] {
    CBO_INVAL = 12'h000,
    CBO_CLEAN = 12'h001,
    CBO_FLUSH = 12'h002,
    CBO_ZERO  = 12'h004
  } cbo_f12_e;

  typedef enum logic [4:0] {
    AMO5_ADD  = 5'b00000,
    AMO5_SWAP = 5'b00001,
    AMO5_LR   = 5'b00010,
    AMO5_SC   = 5'b00011,
    AMO5_XOR  = 5'b00100,
    AMO5_OR   = 5'b01000,
    AMO5_AND  = 5'b01100,
    AMO5_MIN  = 5'b10000,
    AMO5_MAX  = 5'b10100,
    AMO5_MINU = 5'b11000,
    AMO5_MAXU = 5'b11100
  } amo_f5_e;

  // ---- Bit manipulation (OPC_BITMANIP, R layout) ------------------------------
  typedef enum logic [2:0] {
    F3_BM_UNARY = 3'b000,
    F3_BM_ROL   = 3'b001,
    F3_BM_MIN   = 3'b100,
    F3_BM_ROR   = 3'b101,
    F3_BM_MAX   = 3'b110,
    F3_BM_CZERO = 3'b111
  } bm_f3_e;

  typedef enum logic [4:0] {
    BMU_CLZ   = 5'd0,
    BMU_CTZ   = 5'd1,
    BMU_CPOP  = 5'd2,
    BMU_SEXTB = 5'd3,
    BMU_SEXTH = 5'd4,
    BMU_REV8  = 5'd5
  } bm_unary_e;

  // ---- Floating point (OPC_FP_OP: funct7 = {funct5, fmt}) ---------------------
  typedef enum logic [4:0] {
    FP5_ADD     = 5'b00000,
    FP5_SUB     = 5'b00001,
    FP5_MUL     = 5'b00010,
    FP5_DIV     = 5'b00011,
    FP5_SGNJ    = 5'b00100,
    FP5_MINMAX  = 5'b00101,
    FP5_CVT_F2F = 5'b01000,
    FP5_SQRT    = 5'b01011,
    FP5_CMP     = 5'b10100,
    FP5_CVT_F2I = 5'b11000,
    FP5_CVT_I2F = 5'b11010,
    FP5_MV_F2X  = 5'b11100,
    FP5_MV_X2F  = 5'b11110
  } fp_f5_e;

  typedef enum logic [1:0] {
    FPFMT_S = 2'b00,
    FPFMT_D = 2'b01
  } fp_fmt_e;

  // Fused multiply-add executes at FLEN; fmt selects the negation variant.
  typedef enum logic [1:0] {
    FMA_MADD  = 2'b00,
    FMA_MSUB  = 2'b01,
    FMA_NMSUB = 2'b10,
    FMA_NMADD = 2'b11
  } fma_var_e;

  typedef enum logic [2:0] {
    RM_RNE = 3'b000,
    RM_RTZ = 3'b001,
    RM_RDN = 3'b010,
    RM_RUP = 3'b011,
    RM_RMM = 3'b100,
    RM_DYN = 3'b111
  } fp_rm_e;

  // ---- Vector (OPC_VEC_ARITH: funct3 = operand category) ----------------------
  typedef enum logic [2:0] {
    VOP_IVV = 3'b000,
    VOP_FVV = 3'b001,
    VOP_MVV = 3'b010,
    VOP_IVI = 3'b011,
    VOP_IVX = 3'b100,
    VOP_FVF = 3'b101,
    VOP_MVX = 3'b110
  } vop_cat_e;

  typedef enum logic [5:0] {
    VI6_ADD     = 6'b000000,
    VI6_SUB     = 6'b000010,
    VI6_MIN     = 6'b000101,
    VI6_MAX     = 6'b000111,
    VI6_AND     = 6'b001001,
    VI6_OR      = 6'b001010,
    VI6_XOR     = 6'b001011,
    VI6_GATHER  = 6'b001100,
    VI6_SLIDEUP = 6'b001110,
    VI6_SLIDEDN = 6'b001111,
    VI6_MERGE   = 6'b010111,
    VI6_SLL     = 6'b100101,
    VI6_SRL     = 6'b101000,
    VI6_SRA     = 6'b101001
  } vi_f6_e;

  typedef enum logic [5:0] {
    VM6_REDSUM   = 6'b000000,
    VM6_REDMAX   = 6'b000111,
    VM6_COMPRESS = 6'b010111,
    VM6_MUL      = 6'b100101,
    VM6_MACC     = 6'b101101
  } vm_f6_e;

  typedef enum logic [5:0] {
    VF6_ADD  = 6'b000000,
    VF6_MUL  = 6'b100100,
    VF6_MACC = 6'b101100
  } vf_f6_e;

  typedef enum logic [2:0] {
    F3_VSETVL  = 3'b000,
    F3_VSETVLI = 3'b111
  } vcfg_f3_e;

  typedef enum logic [1:0] {
    VMOP_UNIT    = 2'b00,
    VMOP_INDEXED = 2'b01,
    VMOP_STRIDED = 2'b10
  } vmop_e;

  typedef enum logic [2:0] {
    VMW_8  = 3'b000,
    VMW_16 = 3'b101,
    VMW_32 = 3'b110,
    VMW_64 = 3'b111
  } vmem_w_e;

  // ---- Tensor (OPC_TNS_MMA / OPC_TNS_CTRL: T layout) --------------------------
  typedef enum logic [1:0] {
    TMMA_INT8 = 2'b00,
    TMMA_FP8  = 2'b01,
    TMMA_FP16 = 2'b10,
    TMMA_BF16 = 2'b11
  } tns_mma_dt_e;

  typedef enum logic [4:0] {
    TF5_ZERO      = 5'd0,
    TF5_ACC_READ  = 5'd1,
    TF5_RELU      = 5'd2,
    TF5_GELU      = 5'd3,
    TF5_TRANSPOSE = 5'd4,
    TF5_SYNC      = 5'd5
  } tns_ctrl_f5_e;

  // ---- System (OPC_SYSTEM, funct3 = F3_PRIV: funct12) -------------------------
  typedef enum logic [11:0] {
    F12_ECALL  = 12'h000,
    F12_EBREAK = 12'h001,
    F12_SRET   = 12'h102,
    F12_WFI    = 12'h105,
    F12_MRET   = 12'h302,
    F12_DRET   = 12'h7B2
  } sys_f12_e;

  // ---- CSR address space ------------------------------------------------------
  localparam int unsigned CSR_ADDR_W   = 12;
  localparam logic [11:0] CSR_SATP     = 12'h180;
  localparam logic [1:0]  CSR_RO_CODE  = 2'b11;
  localparam logic [7:0]  CSR_DBG_PAGE = 8'h7B;

  // ---- Instruction formats ----------------------------------------------------
  typedef struct packed {
    logic [6:0]  funct7;
    areg_t       rs2;
    areg_t       rs1;
    logic [2:0]  funct3;
    areg_t       rd;
    opcode_e     opcode;
  } instr_fmt_r_t;

  typedef struct packed {
    logic [11:0] imm;
    areg_t       rs1;
    logic [2:0]  funct3;
    areg_t       rd;
    opcode_e     opcode;
  } instr_fmt_i_t;

  typedef struct packed {
    logic [6:0]  imm_hi;
    areg_t       rs2;
    areg_t       rs1;
    logic [2:0]  funct3;
    logic [4:0]  imm_lo;
    opcode_e     opcode;
  } instr_fmt_s_t;

  typedef struct packed {
    logic [19:0] imm;
    areg_t       rd;
    opcode_e     opcode;
  } instr_fmt_u_t;

  typedef struct packed {
    areg_t       rs3;
    logic [1:0]  fmt;
    areg_t       rs2;
    areg_t       rs1;
    logic [2:0]  rm;
    areg_t       rd;
    opcode_e     opcode;
  } instr_fmt_r4_t;

  typedef struct packed {
    logic [5:0]  funct6;
    logic        vm;
    areg_t       vs2;
    areg_t       vs1;
    logic [2:0]  funct3;
    areg_t       vd;
    opcode_e     opcode;
  } instr_fmt_v_t;

  typedef struct packed {
    logic [4:0]  tfunct5;
    logic [1:0]  dtype;
    logic [1:0]  rsvd;
    treg_t       ts2;
    logic [1:0]  rsvd1;
    treg_t       ts1;
    logic [2:0]  tfunct3;
    logic [1:0]  rsvd2;
    treg_t       td;
    opcode_e     opcode;
  } instr_fmt_t_t;

  // Branch formats share the S layout; jumps share the U layout.
  typedef union packed {
    instr_t        raw;
    instr_fmt_r_t  r;
    instr_fmt_i_t  i;
    instr_fmt_s_t  s;
    instr_fmt_s_t  b;
    instr_fmt_u_t  u;
    instr_fmt_u_t  j;
    instr_fmt_r4_t r4;
    instr_fmt_v_t  v;
    instr_fmt_t_t  t;
  } instr_word_t;

  // ===========================================================================
  // 6. Micro-Op Operation Encodings (per functional unit)
  // ===========================================================================

  typedef enum logic [UOP_OP_W-1:0] {
    ALU_ADD,  ALU_SUB,  ALU_SLL,  ALU_SLT,  ALU_SLTU, ALU_XOR,  ALU_SRL,  ALU_SRA,
    ALU_OR,   ALU_AND,  ALU_ADDW, ALU_SUBW, ALU_SLLW, ALU_SRLW, ALU_SRAW, ALU_LUI,
    ALU_AUIPC,ALU_ANDN, ALU_ORN,  ALU_XNOR, ALU_CLZ,  ALU_CTZ,  ALU_CPOP, ALU_MIN,
    ALU_MAX,  ALU_MINU, ALU_MAXU, ALU_ROL,  ALU_ROR,  ALU_REV8, ALU_SEXTB,ALU_SEXTH,
    ALU_CZERO_EQZ, ALU_CZERO_NEZ
  } alu_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    MDU_MUL,  MDU_MULH, MDU_MULHSU, MDU_MULHU, MDU_MULW,
    MDU_DIV,  MDU_DIVU, MDU_REM,    MDU_REMU,
    MDU_DIVW, MDU_DIVUW,MDU_REMW,   MDU_REMUW
  } mdu_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    BRU_EQ, BRU_NE, BRU_LT, BRU_GE, BRU_LTU, BRU_GEU, BRU_JAL, BRU_JALR
  } bru_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    LSU_LOAD,     LSU_STORE,    LSU_LR,       LSU_SC,
    LSU_AMO_SWAP, LSU_AMO_ADD,  LSU_AMO_XOR,  LSU_AMO_AND,
    LSU_AMO_OR,   LSU_AMO_MIN,  LSU_AMO_MAX,  LSU_AMO_MINU,
    LSU_AMO_MAXU, LSU_FENCE,    LSU_FENCE_I,  LSU_SFENCE_VMA,
    LSU_PREFETCH, LSU_CBO_CLEAN,LSU_CBO_FLUSH,LSU_CBO_INVAL,
    LSU_CBO_ZERO
  } lsu_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    CSR_RW, CSR_RS, CSR_RC, CSR_ECALL, CSR_EBREAK,
    CSR_MRET, CSR_SRET, CSR_DRET, CSR_WFI
  } csr_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    FPU_ADD,     FPU_SUB,     FPU_MUL,     FPU_DIV,     FPU_SQRT,
    FPU_MADD,    FPU_MSUB,    FPU_NMADD,   FPU_NMSUB,   FPU_MIN,
    FPU_MAX,     FPU_SGNJ,    FPU_SGNJN,   FPU_SGNJX,   FPU_CVT_F2I,
    FPU_CVT_I2F, FPU_CVT_F2F, FPU_CMP_EQ,  FPU_CMP_LT,  FPU_CMP_LE,
    FPU_CLASS,   FPU_MV_F2X,  FPU_MV_X2F
  } fpu_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    VEC_ADD,     VEC_SUB,     VEC_MUL,     VEC_MACC,    VEC_AND,
    VEC_OR,      VEC_XOR,     VEC_SLL,     VEC_SRL,     VEC_SRA,
    VEC_MIN,     VEC_MAX,     VEC_REDSUM,  VEC_REDMAX,  VEC_SLIDEUP,
    VEC_SLIDEDN, VEC_GATHER,  VEC_COMPRESS,VEC_MERGE,   VEC_MV,
    VEC_FADD,    VEC_FMUL,    VEC_FMACC,   VEC_LD_UNIT, VEC_ST_UNIT,
    VEC_LD_STRD, VEC_ST_STRD, VEC_LD_IDX,  VEC_ST_IDX,  VEC_SETVL
  } vec_op_e;

  typedef enum logic [UOP_OP_W-1:0] {
    TNS_LOAD,      TNS_STORE,     TNS_ZERO,      TNS_MMA_INT8,
    TNS_MMA_FP8,   TNS_MMA_FP16,  TNS_MMA_BF16,  TNS_ACC_READ,
    TNS_ACT_RELU,  TNS_ACT_GELU,  TNS_TRANSPOSE, TNS_CFG,
    TNS_SYNC
  } tns_op_e;

  typedef union packed {
    logic [UOP_OP_W-1:0] raw;
    alu_op_e             alu;
    mdu_op_e             mdu;
    bru_op_e             bru;
    lsu_op_e             lsu;
    csr_op_e             csr;
    fpu_op_e             fpu;
    vec_op_e             vec;
    tns_op_e             tns;
  } uop_op_u;

  // ===========================================================================
  // 7. Vector / Tensor Configuration Types
  // ===========================================================================

  typedef enum logic [2:0] {
    SEW_8  = 3'd0,
    SEW_16 = 3'd1,
    SEW_32 = 3'd2,
    SEW_64 = 3'd3
  } vsew_e;

  typedef enum logic [2:0] {
    LMUL_1  = 3'b000,
    LMUL_2  = 3'b001,
    LMUL_4  = 3'b010,
    LMUL_8  = 3'b011,
    LMUL_F8 = 3'b101,
    LMUL_F4 = 3'b110,
    LMUL_F2 = 3'b111
  } vlmul_e;

  typedef struct packed {
    logic   vill;
    logic   vma;
    logic   vta;
    vsew_e  vsew;
    vlmul_e vlmul;
  } vtype_t;

  typedef enum logic [2:0] {
    TDT_INT8     = 3'd0,
    TDT_FP8_E4M3 = 3'd1,
    TDT_FP8_E5M2 = 3'd2,
    TDT_FP16     = 3'd3,
    TDT_BF16     = 3'd4,
    TDT_FP32     = 3'd5,
    TDT_INT32    = 3'd6
  } tns_dtype_e;

  typedef struct packed {
    logic [TNS_DIM_W-1:0] m;
    logic [TNS_DIM_W-1:0] n;
    logic [TNS_DIM_W-1:0] k;
    tns_dtype_e           src_dtype;
    tns_dtype_e           acc_dtype;
    logic                 saturate;
  } tns_cfg_t;

  // ===========================================================================
  // 8. Exception, Interrupt and Fault Taxonomy                          [ARCH]
  // ===========================================================================

  typedef enum logic [5:0] {
    EXC_INSTR_MISALIGNED   = 6'd0,
    EXC_INSTR_ACCESS_FAULT = 6'd1,
    EXC_ILLEGAL_INSTR      = 6'd2,
    EXC_BREAKPOINT         = 6'd3,
    EXC_LOAD_MISALIGNED    = 6'd4,
    EXC_LOAD_ACCESS_FAULT  = 6'd5,
    EXC_STORE_MISALIGNED   = 6'd6,
    EXC_STORE_ACCESS_FAULT = 6'd7,
    EXC_ECALL_U            = 6'd8,
    EXC_ECALL_S            = 6'd9,
    EXC_ECALL_M            = 6'd11,
    EXC_INSTR_PAGE_FAULT   = 6'd12,
    EXC_LOAD_PAGE_FAULT    = 6'd13,
    EXC_STORE_PAGE_FAULT   = 6'd15,
    EXC_INSTR_ECC_FAULT    = 6'd24,
    EXC_DATA_ECC_FAULT     = 6'd25,
    EXC_VEC_ILLEGAL_CFG    = 6'd26,
    EXC_TNS_FAULT          = 6'd27,
    EXC_HW_ERROR           = 6'd31
  } exc_cause_e;

  typedef enum logic [5:0] {
    IRQ_S_SOFT  = 6'd1,
    IRQ_M_SOFT  = 6'd3,
    IRQ_S_TIMER = 6'd5,
    IRQ_M_TIMER = 6'd7,
    IRQ_S_EXT   = 6'd9,
    IRQ_M_EXT   = 6'd11,
    IRQ_PMU_OVF = 6'd13,
    IRQ_RAS_ERR = 6'd16
  } irq_cause_e;

  typedef enum logic [2:0] {
    XCLS_FETCH         = 3'd0,
    XCLS_DECODE        = 3'd1,
    XCLS_EXECUTE       = 3'd2,
    XCLS_MEMORY        = 3'd3,
    XCLS_SYSTEM        = 3'd4,
    XCLS_ASYNC         = 3'd5,
    XCLS_MACHINE_CHECK = 3'd6
  } exc_class_e;

  typedef enum logic [2:0] {
    FSRC_CORE   = 3'd0,
    FSRC_LLC    = 3'd1,
    FSRC_FABRIC = 3'd2,
    FSRC_MEM    = 3'd3,
    FSRC_DMA    = 3'd4,
    FSRC_CLUSTER = 3'd5
  } fault_src_e;

  typedef enum logic [3:0] {
    FLT_NONE       = 4'd0,
    FLT_ECC_CE     = 4'd1,
    FLT_ECC_UE     = 4'd2,
    FLT_PARITY     = 4'd3,
    FLT_PROTOCOL   = 4'd4,
    FLT_TIMEOUT    = 4'd5,
    FLT_DECODE_ERR = 4'd6,
    FLT_SLAVE_ERR  = 4'd7,
    FLT_POISON     = 4'd8,
    FLT_LOCKSTEP   = 4'd9,
    FLT_DRAIN_HANG = 4'd10
  } fault_code_e;

  typedef enum logic [1:0] {                                          // ordered
    FSEV_CORRECTED     = 2'd0,
    FSEV_RECOVERABLE   = 2'd1,
    FSEV_UNCORRECTABLE = 2'd2,
    FSEV_FATAL         = 2'd3
  } fault_sev_e;

  typedef struct packed {
    logic        valid;
    exc_cause_e  cause;
    xlen_t       tval;
  } exc_info_t;

  typedef struct packed {
    logic        valid;
    logic        is_irq;
    exc_cause_e  exc_cause;
    irq_cause_e  irq_cause;
    exc_class_e  cls;
    priv_e       from_priv;
    priv_e       to_priv;
    vaddr_t      epc;
    xlen_t       tval;
  } trap_info_t;

  typedef struct packed {
    logic meip;
    logic seip;
    logic mtip;
    logic stip;
    logic msip;
    logic ssip;
    logic pmu_ovf;
    logic ras_err;
    logic nmi;
  } core_irq_t;

  typedef struct packed {
    logic                    valid;
    fault_src_e              src;
    logic [FAULT_UNIT_W-1:0] unit;
    fault_code_e             code;
    fault_sev_e              sev;
    paddr_t                  addr;
  } fault_rec_t;

  // ===========================================================================
  // 9. Branch Prediction Interfaces
  // ===========================================================================

  typedef struct packed {
    logic        valid;
    vaddr_t      pc;
    asid_t       asid;
  } btb_req_t;

  typedef struct packed {
    logic        hit;
    fetch_lane_t cfi_lane;
    cfi_type_e   cfi_type;
    vaddr_t      target;
    bp_conf_t    conf;
  } btb_rsp_t;

  typedef struct packed {
    logic        valid;
    vaddr_t      pc;
    ghist_t      ghist;
  } bht_req_t;

  typedef struct packed {
    fetch_mask_t                  taken;
    bp_conf_t [FETCH_WIDTH-1:0]   conf;
  } bht_rsp_t;

  typedef struct packed {
    logic        valid;
    vaddr_t      addr;
    ras_ptr_t    ptr;
  } ras_top_t;

  // Applied atomically by the RAS in order: restore, then pop or push.
  typedef struct packed {
    logic        restore;
    ras_ptr_t    restore_ptr;
    logic        pop;
    logic        push;
    vaddr_t      push_addr;
  } ras_update_t;

  typedef struct packed {
    ghist_t      ghist;
    ras_ptr_t    ras_ptr;
  } bp_snapshot_t;

  typedef struct packed {
    logic        btb_hit;
    logic        taken;
    fetch_lane_t cfi_lane;
    cfi_type_e   cfi_type;
    vaddr_t      target;
    bp_conf_t    conf;
    bp_snapshot_t snap;
  } fetch_pred_t;

  typedef struct packed {
    logic        valid;
    vaddr_t      pc;
    cfi_type_e   cfi_type;
    logic        taken;
    logic        mispredict;
    vaddr_t      target;
    ghist_t      ghist;
    bp_conf_t    conf;
  } bp_update_t;

  // ===========================================================================
  // 10. Frontend Transactions
  // ===========================================================================

  typedef struct packed {
    logic            valid;
    redirect_cause_e cause;
    vaddr_t          target;
    logic            has_cfi;
    vaddr_t          cfi_pc;
    cfi_type_e       cfi_type;
    logic            taken;
    bp_snapshot_t    snap;
  } fe_redirect_t;

  typedef struct packed {
    logic        is_cfi;
    cfi_type_e   cfi_type;
    logic        is_direct;
    imm_t        offset;
  } predecode_t;

  typedef struct packed {
    vaddr_t                       pc;
    vaddr_t                       next_pc;
    fetch_mask_t                  lane_valid;
    instr_t    [FETCH_WIDTH-1:0]  instr;
    cfi_type_e [FETCH_WIDTH-1:0]  lane_cfi;
    fetch_pred_t                  pred;
    exc_info_t                    exc;
    fetch_seq_t                   seq;
  } fetch_pkt_t;

  typedef struct packed {
    logic        fetch_fire;
    logic        bubble;
    logic        icache_stall;
    logic        credit_stall;
    logic        pred_taken;
    logic        pred_redirect;
    logic        pd_redirect;
    logic        be_redirect;
    logic        replay;
    logic        fault_halt;
  } fe_perf_t;

  // ===========================================================================
  // 11. Decode / Rename / Issue / Execute / Writeback / Commit Transactions
  // ===========================================================================

  typedef struct packed {
    logic        serialize;
    logic        fence;
    logic        is_load;
    logic        is_store;
    logic        is_amo;
    logic        is_cfi;
    logic        word_op;
    logic        vec_cfg_dep;
    logic        tns_dep;
    logic        fp_rm_dyn;
  } uop_flags_t;

  typedef struct packed {
    cfi_type_e   cfi_type;
    logic        pred_taken;
    vaddr_t      pred_target;
    bp_conf_t    conf;
  } uop_bp_t;

  typedef enum logic [2:0] {
    MSZ_B    = 3'd0,
    MSZ_H    = 3'd1,
    MSZ_W    = 3'd2,
    MSZ_D    = 3'd3,
    MSZ_Q    = 3'd4,
    MSZ_LINE = 3'd6
  } mem_size_e;

  typedef struct packed {
    logic        valid;
    vaddr_t      pc;
    instr_t      instr;
    fu_type_e    fu;
    uop_op_u     op;
    reg_class_e  rs1_class;
    reg_class_e  rs2_class;
    reg_class_e  rs3_class;
    reg_class_e  rd_class;
    areg_t       rs1;
    areg_t       rs2;
    areg_t       rs3;
    areg_t       rd;
    opnd_sel_e   opnd_a;
    opnd_sel_e   opnd_b;
    imm_t        imm;
    mem_size_e   mem_size;
    logic        mem_signed;
    uop_bp_t     bp;
    uop_flags_t  flags;
    exc_info_t   exc;
  } uop_t;

  // ---- Decode metadata --------------------------------------------------------
  typedef enum logic [1:0] {
    IFMT_R = 2'd0,
    IFMT_I = 2'd1,
    IFMT_M = 2'd2,
    IFMT_X = 2'd3
  } instr_fmt_e;

  typedef enum logic [3:0] {
    ICLS_ALU     = 4'd0,
    ICLS_MUL     = 4'd1,
    ICLS_DIV     = 4'd2,
    ICLS_BRANCH  = 4'd3,
    ICLS_JUMP    = 4'd4,
    ICLS_LOAD    = 4'd5,
    ICLS_STORE   = 4'd6,
    ICLS_AMO     = 4'd7,
    ICLS_FENCE   = 4'd8,
    ICLS_CSR     = 4'd9,
    ICLS_SYSTEM  = 4'd10,
    ICLS_FP      = 4'd11,
    ICLS_VEC     = 4'd12,
    ICLS_TNS     = 4'd13,
    ICLS_CUSTOM  = 4'd14,
    ICLS_ILLEGAL = 4'd15
  } instr_class_e;

  typedef enum logic [1:0] {                                          // {aq, rl}
    MORD_RELAXED = 2'b00,
    MORD_RELEASE = 2'b01,
    MORD_ACQUIRE = 2'b10,
    MORD_ACQ_REL = 2'b11
  } mem_order_e;

  typedef struct packed {
    logic i;
    logic o;
    logic r;
    logic w;
  } fence_set_t;

  typedef logic [TNS_NUM_TREGS-1:0] tile_mask_t;

  typedef struct packed {
    logic        rs1_rd;
    logic        rs2_rd;
    logic        rs3_rd;
    logic        rd_wr;
    logic        mask_rd;
    logic        vtype_rd;
    logic        vtype_wr;
    logic        ldq_alloc;
    logic        stq_alloc;
    logic        br_alloc;
    logic        spec_barrier;
    logic        commit_exec;
    tile_mask_t  tile_rd;
    tile_mask_t  tile_wr;
  } dep_meta_t;

  typedef struct packed {
    logic        active;
    logic        masked;
    vop_cat_e    cat;
    vmop_e       mop;
    logic [5:0]  funct6;
  } vec_meta_t;

  typedef struct packed {
    logic        active;
    tns_dtype_e  dtype;
    treg_t       td;
    treg_t       ts1;
    treg_t       ts2;
  } tns_meta_t;

  typedef struct packed {
    instr_fmt_e   fmt;
    imm_fmt_e     imm_fmt;
    instr_class_e cls;
    priv_e        min_priv;
    mem_order_e   mem_order;
    fence_set_t   fence_pred;
    fence_set_t   fence_succ;
    vaddr_t       cfi_target;
    dep_meta_t    dep;
    vec_meta_t    vec;
    tns_meta_t    tns;
  } dec_meta_t;

  // Architectural state qualifying decode legality (sourced from the CSR file).
  typedef struct packed {
    priv_e       priv;
    logic        debug_mode;
    logic        fp_en;
    logic        vec_en;
    logic        tns_en;
    logic        xcustom_en;
    logic        tvm;
    logic        tw;
    logic        tsr;
    logic        vill;
  } dec_ctrl_t;

  typedef struct packed {
    logic                    pkt_fire;
    logic [DECODE_CNT_W-1:0] lanes;
    logic                    illegal;
    logic                    serialize;
    logic                    backpressure;
    logic                    starved;
    logic                    flush;
    logic                    replay;
  } dec_perf_t;

  // uop[i].imm conventions : IMM_Z carries {zimm[16:12], csr[11:0]};
  //                          IMM_V5 carries sign-extended vs1-field immediate.
  // uop[i].bp.pred_target  : predicted successor PC of the instruction.
  typedef struct packed {
    uop_t      [DECODE_WIDTH-1:0] uop;
    dec_meta_t [DECODE_WIDTH-1:0] meta;
    bp_snapshot_t                 snap;
    fetch_seq_t                   seq;
  } decode_pkt_t;

  typedef struct packed {
    preg_t       prs1;
    preg_t       prs2;
    preg_t       prs3;
    preg_t       pdst;
    preg_t       stale_pdst;
    logic        prs1_busy;
    logic        prs2_busy;
    logic        prs3_busy;
  } preg_map_t;

  typedef struct packed {
    uop_t        uop;
    preg_map_t   map;
    rob_idx_t    rob_idx;
    ldq_idx_t    ldq_idx;
    stq_idx_t    stq_idx;
    br_tag_t     br_tag;
    br_mask_t    br_mask;
  } rename_uop_t;

  typedef struct packed {
    rename_uop_t [RENAME_WIDTH-1:0] uop;
  } rename_pkt_t;

  typedef struct packed {
    logic        valid;
    rob_idx_t    rob_idx;
    fu_type_e    fu;
    uop_op_u     op;
    preg_map_t   map;
    reg_class_e  rd_class;
    opnd_sel_e   opnd_a;
    opnd_sel_e   opnd_b;
    imm_t        imm;
    vaddr_t      pc;
    uop_bp_t     bp;
    br_tag_t     br_tag;
    br_mask_t    br_mask;
    ldq_idx_t    ldq_idx;
    stq_idx_t    stq_idx;
    mem_size_e   mem_size;
    logic        mem_signed;
    uop_flags_t  flags;
  } issue_pkt_t;

  typedef struct packed {
    issue_pkt_t  iss;
    xlen_t       opnd_a;
    xlen_t       opnd_b;
    xlen_t       opnd_c;
  } exec_pkt_t;

  typedef struct packed {
    logic        valid;
    rob_idx_t    rob_idx;
    br_tag_t     br_tag;
    logic        mispredict;
    logic        taken;
    cfi_type_e   cfi_type;
    vaddr_t      cfi_pc;
    vaddr_t      target;
  } br_resolve_t;

  typedef struct packed {
    logic                valid;
    rob_idx_t            rob_idx;
    reg_class_e          rd_class;
    logic                wen;
    preg_t               pdst;
    xlen_t               data;
    logic [FFLAGS_W-1:0] fflags;
