  // ===========================================================================
  // 15. Host Control, Debug and Observability
  // ===========================================================================

  typedef struct packed {
    logic [APB_ADDR_W-1:0] paddr;
    logic                  psel;
    logic                  penable;
    logic                  pwrite;
    logic [APB_DATA_W-1:0] pwdata;
    logic [APB_STRB_W-1:0] pstrb;
    logic [2:0]            pprot;
  } apb_req_t;

  typedef struct packed {
    logic [APB_DATA_W-1:0] prdata;
    logic                  pready;
    logic                  pslverr;
  } apb_rsp_t;

  // ---- Host address map (APB_ADDR_W = 24, 64 KiB regions) -------------------
  localparam int unsigned          HOST_RGN_LSB      = 16;
  localparam int unsigned          HOST_RGN_W        = APB_ADDR_W - HOST_RGN_LSB;
  localparam logic [HOST_RGN_W-1:0] HOST_RGN_CLUSTER = 8'h00;
  localparam logic [HOST_RGN_W-1:0] HOST_RGN_IRQ     = 8'h01;
  localparam logic [HOST_RGN_W-1:0] HOST_RGN_PMU     = 8'h02;

  // ---- Cluster control register map (byte offsets within HOST_RGN_CLUSTER) --
  localparam int unsigned          CLCSR_OFF_W       = 12;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_ID          = 12'h000;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_CFG         = 12'h004;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_CTRL        = 12'h008;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_CORE_EN     = 12'h00C;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_BOOT_LO     = 12'h010;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_BOOT_HI     = 12'h014;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_STATUS      = 12'h018;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_CORE_STATE  = 12'h01C;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_ISOLATE     = 12'h020;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_COH_DOMAIN  = 12'h024;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_FAULT_STAT  = 12'h028;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_FAULT_ADDR0 = 12'h02C;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_FAULT_ADDR1 = 12'h030;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_FAULT_CNT   = 12'h034;
  localparam logic [CLCSR_OFF_W-1:0] CLCSR_SCRATCH     = 12'h03C;

  // CLCSR_CTRL bit assignments
  localparam int unsigned CLCTRL_CLUSTER_EN   = 0;
  localparam int unsigned CLCTRL_CONTAIN_EN   = 1;
  localparam int unsigned CLCTRL_WARM_RESET   = 2;
  localparam int unsigned CLCTRL_FAULT_IRQ_EN = 3;

  // ---- Debug module interface ---------------------------------------------------
  typedef enum logic [1:0] {
    DMI_OP_NOP   = 2'd0,
    DMI_OP_READ  = 2'd1,
    DMI_OP_WRITE = 2'd2
  } dmi_op_e;

  typedef enum logic [1:0] {
    DMI_RSP_OK     = 2'd0,
    DMI_RSP_FAILED = 2'd2,
    DMI_RSP_BUSY   = 2'd3
  } dmi_resp_e;

  typedef struct packed {
    logic [DMI_ADDR_W-1:0] addr;
    logic [DMI_DATA_W-1:0] data;
    dmi_op_e               op;
  } dmi_req_t;

  typedef struct packed {
    logic [DMI_DATA_W-1:0] data;
    dmi_resp_e             resp;
  } dmi_rsp_t;

  typedef struct packed {
    logic                   haltreq;
    logic                   resumereq;
    logic                   ackhavereset;
    logic                   cmd_valid;
    logic                   cmd_write;
    logic [DBG_REGNO_W-1:0] cmd_regno;
    xlen_t                  cmd_wdata;
  } dbg_core_req_t;

  typedef struct packed {
    logic                   halted;
    logic                   running;
    logic                   havereset;
    logic                   cmd_done;
    logic                   cmd_err;
    xlen_t                  cmd_rdata;
  } dbg_core_rsp_t;

  // ---- Core lifecycle status ----------------------------------------------------
  typedef struct packed {
    logic        wfi;
    logic        halted;
    logic        quiesced;
    logic        idle;
    priv_e       priv;
  } core_status_t;

  // ---- Instruction trace --------------------------------------------------------
  typedef enum logic [2:0] {
    TRC_SYNC      = 3'd0,
    TRC_BRANCH    = 3'd1,
    TRC_INDIRECT  = 3'd2,
    TRC_TRAP      = 3'd3,
    TRC_XRET      = 3'd4,
    TRC_CONTEXT   = 3'd5,
    TRC_OVERFLOW  = 3'd6
  } trace_kind_e;

  typedef struct packed {
    trace_kind_e kind;
    core_id_t    core;
    priv_e       priv;
    vaddr_t      pc;
    vaddr_t      target;
    logic [7:0]  icount;
    timestamp_t  ts;
  } trace_pkt_t;

  // ---- Performance events (bit index into event vectors) -------------------
  typedef enum logic [3:0] {
    PEV_CYCLE_ACTIVE  = 4'd0,
    PEV_INSTRET       = 4'd1,
    PEV_FETCH_BUBBLE  = 4'd2,
    PEV_ICACHE_MISS   = 4'd3,
    PEV_ITLB_MISS     = 4'd4,
    PEV_BR_MISPRED    = 4'd5,
    PEV_PD_REDIRECT   = 4'd6,
    PEV_DCACHE_MISS   = 4'd7,
    PEV_DTLB_MISS     = 4'd8,
    PEV_LD_ORDER_FAIL = 4'd9,
    PEV_ROB_FULL      = 4'd10,
    PEV_ISSUE_STALL   = 4'd11,
    PEV_VEC_ACTIVE    = 4'd12,
    PEV_TNS_ACTIVE    = 4'd13,
    PEV_SNOOP_RX      = 4'd14,
    PEV_TRAP          = 4'd15
  } core_perf_evt_e;

  localparam int unsigned NUM_CORE_PERF_EVT = 16;
  typedef logic [NUM_CORE_PERF_EVT-1:0] core_perf_t;

  typedef enum logic [2:0] {
    PEV_LLC_ACCESS    = 3'd0,
    PEV_LLC_MISS      = 3'd1,
    PEV_LLC_WRITEBACK = 3'd2,
    PEV_LLC_SNOOP     = 3'd3,
    PEV_LLC_RETRY     = 3'd4,
    PEV_LLC_ECC_CE    = 3'd5
  } llc_perf_evt_e;

  localparam int unsigned NUM_LLC_PERF_EVT = 8;
  typedef logic [NUM_LLC_PERF_EVT-1:0] llc_perf_t;

  typedef struct packed {
    logic [MAX_LLC_BANKS-1:0] bank_req_stall;
    logic [MAX_CORES-1:0]     core_rsp_stall;
    logic [MAX_CORES-1:0]     core_snp_stall;
    logic                     dma_active;
    logic                     mem_req_stall;
  } fabric_perf_t;

  // ===========================================================================
  // 16. Utility Functions (pure combinational, synthesis-safe)
  // ===========================================================================

  // ---- Opcode taxonomy ----------------------------------------------------------
  function automatic opc_group_e sf_opc_group(input instr_t instr);
    return opc_group_e'(instr[6:4]);
  endfunction

  function automatic logic sf_is_32b(input instr_t instr);
    return (instr[1:0] == OPC_LEN_32);
  endfunction

  function automatic logic sf_is_link(input areg_t r);
    return (r == AREG_RA) || (r == AREG_ALT_LINK);
  endfunction

  // ---- Immediate extraction (sign-extended to IMM_W) ----------------------------
  function automatic imm_t sf_imm_i(input instr_t instr);
    return {{(IMM_W-12){instr[31]}}, instr[31:20]};
  endfunction

  function automatic imm_t sf_imm_s(input instr_t instr);
    return {{(IMM_W-12){instr[31]}}, instr[31:25], instr[11:7]};
  endfunction

  function automatic imm_t sf_imm_b(input instr_t instr);
    return {{(IMM_W-14){instr[31]}}, instr[31:25], instr[11:7], 2'b00};
  endfunction

  function automatic imm_t sf_imm_u(input instr_t instr);
    return {instr[31:12], 12'h000};
  endfunction

  function automatic imm_t sf_imm_j(input instr_t instr);
    return {{(IMM_W-22){instr[31]}}, instr[31:12], 2'b00};
  endfunction

  // ---- Control-flow predecode -----------------------------------------------------
  function automatic predecode_t sf_predecode(input instr_t instr);
    predecode_t pd;
    areg_t      rd;
    areg_t      rs1;
    rd  = instr[11:7];
    rs1 = instr[19:15];
    pd  = '{is_cfi: 1'b0, cfi_type: CFI_NONE, is_direct: 1'b0, offset: '0};
    if (sf_is_32b(instr)) begin
      case (opcode_e'(instr[6:0]))
        OPC_BRANCH: begin
          pd.is_cfi    = 1'b1;
          pd.cfi_type  = CFI_BRANCH;
          pd.is_direct = 1'b1;
          pd.offset    = sf_imm_b(instr);
        end
        OPC_JAL: begin
          pd.is_cfi    = 1'b1;
          pd.cfi_type  = sf_is_link(rd) ? CFI_CALL : CFI_JUMP;
          pd.is_direct = 1'b1;
          pd.offset    = sf_imm_j(instr);
        end
        OPC_JALR: begin
          pd.is_cfi    = 1'b1;
          pd.cfi_type  = sf_is_link(rd)  ? CFI_INDIRECT_CALL :
                         sf_is_link(rs1) ? CFI_RET           : CFI_INDIRECT;
        end
        default: ;
      endcase
    end
    return pd;
  endfunction

  function automatic logic sf_cfi_is_call(input cfi_type_e t);
    return (t == CFI_CALL) || (t == CFI_INDIRECT_CALL);
  endfunction

  function automatic logic sf_cfi_is_uncond(input cfi_type_e t);
    return (t != CFI_NONE) && (t != CFI_BRANCH);
  endfunction

  // ---- Fetch geometry ---------------------------------------------------------------
  function automatic vaddr_t sf_fetch_block(input vaddr_t pc);
    return {pc[VADDR_W-1:FETCH_OFF_W], {FETCH_OFF_W{1'b0}}};
  endfunction

  function automatic fetch_lane_t sf_fetch_lane(input vaddr_t pc);
    return pc[FETCH_OFF_W-1:INSTR_OFF_W];
  endfunction

  function automatic vaddr_t sf_lane_pc(input vaddr_t block, input fetch_lane_t lane);
    return block | vaddr_t'({lane, {INSTR_OFF_W{1'b0}}});
  endfunction

  // ---- Global history ----------------------------------------------------------------
  function automatic ghist_t sf_ghist_push(input ghist_t h, input logic taken);
    return {h[GHIST_W-2:0], taken};
  endfunction

  // Block-granular history: one bit per fetch block terminated by a conditional.
  function automatic ghist_t sf_ghist_advance(input ghist_t h, input cfi_type_e t, input logic taken);
    return (t == CFI_BRANCH) ? sf_ghist_push(h, taken) : h;
  endfunction

  // ---- Exception classification ----------------------------------------------------
  function automatic exc_class_e sf_exc_class(input exc_cause_e c);
    case (c)
      EXC_INSTR_MISALIGNED,
      EXC_INSTR_ACCESS_FAULT,
      EXC_INSTR_PAGE_FAULT,
      EXC_INSTR_ECC_FAULT:    return XCLS_FETCH;
      EXC_ILLEGAL_INSTR,
      EXC_VEC_ILLEGAL_CFG:    return XCLS_DECODE;
      EXC_LOAD_MISALIGNED,
      EXC_LOAD_ACCESS_FAULT,
      EXC_STORE_MISALIGNED,
      EXC_STORE_ACCESS_FAULT,
      EXC_LOAD_PAGE_FAULT,
      EXC_STORE_PAGE_FAULT,
      EXC_DATA_ECC_FAULT:     return XCLS_MEMORY;
      EXC_BREAKPOINT,
      EXC_ECALL_U,
      EXC_ECALL_S,
      EXC_ECALL_M:            return XCLS_SYSTEM;
      EXC_HW_ERROR:           return XCLS_MACHINE_CHECK;
      default:                return XCLS_EXECUTE;
    endcase
  endfunction

  // ---- Speculation masks -------------------------------------------------------------
  function automatic logic sf_br_killed(input br_mask_t mask, input br_resolve_t res);
    return res.valid && res.mispredict && mask[res.br_tag];
  endfunction

  function automatic br_mask_t sf_br_clear(input br_mask_t mask, input br_resolve_t res);
    return res.valid ? (mask & ~(br_mask_t'(1) << res.br_tag)) : mask;
  endfunction

  // ---- Arbitration primitives (width ARB_MAX_W, upper bits tie to zero) ----------
  function automatic logic [ARB_MAX_W-1:0] sf_lowest_set(input logic [ARB_MAX_W-1:0] v);
    return v & (~v + ARB_ONE);
  endfunction

  // Round-robin: highest priority to the requester immediately above last grant.
  function automatic logic [ARB_MAX_W-1:0] sf_rr_grant(
    input logic [ARB_MAX_W-1:0] req,
    input logic [ARB_MAX_W-1:0] last_gnt
  );
    logic [ARB_MAX_W-1:0] above;
    logic [ARB_MAX_W-1:0] req_hi;
    above  = ~((last_gnt << 1) - ARB_ONE);
    req_hi = req & above;
    return (|req_hi) ? sf_lowest_set(req_hi) : sf_lowest_set(req);
  endfunction

  function automatic logic [ARB_IDX_W-1:0] sf_oh2bin(input logic [ARB_MAX_W-1:0] oh);
    logic [ARB_IDX_W-1:0] idx;
    idx = '0;
    for (int unsigned i = 0; i < ARB_MAX_W; i++) begin
      if (oh[i]) idx = idx | ARB_IDX_W'(i);
    end
    return idx;
  endfunction

  function automatic logic [ARB_IDX_W:0] sf_popcount(input logic [ARB_MAX_W-1:0] v);
    logic [ARB_IDX_W:0] cnt;
    cnt = '0;
    for (int unsigned i = 0; i < ARB_MAX_W; i++) begin
      cnt = cnt + (ARB_IDX_W+1)'(v[i]);
    end
    return cnt;
  endfunction

  // ---- Address interleaving ---------------------------------------------------------
  // XOR-folded line-address hash; n_banks must be a power of two.
  function automatic bank_id_t sf_llc_bank_sel(input paddr_t addr, input int unsigned n_banks);
    line_addr_t la;
    bank_id_t   h;
    la = addr[PADDR_W-1:CL_OFF_W];
    h  = la[0 +: BANK_ID_W] ^ la[BANK_ID_W +: BANK_ID_W] ^ la[2*BANK_ID_W +: BANK_ID_W];
    return h & bank_id_t'(n_banks - 1);
  endfunction

  // ---- Byte-strobe merge --------------------------------------------------------------
  function automatic logic [APB_DATA_W-1:0] sf_apb_merge(
    input logic [APB_DATA_W-1:0] cur,
    input logic [APB_DATA_W-1:0] wdata,
    input logic [APB_STRB_W-1:0] strb
  );
    logic [APB_DATA_W-1:0] r;
    for (int unsigned b = 0; b < APB_STRB_W; b++) begin
      r[b*8 +: 8] = strb[b] ? wdata[b*8 +: 8] : cur[b*8 +: 8];
    end
    return r;
  endfunction

  // ---- Fault severity ordering ----------------------------------------------------------
  function automatic logic sf_fault_contains(input fault_rec_t f);
    return f.valid && (f.sev >= FSEV_UNCORRECTABLE);
  endfunction

endpackage : silicaflux_pkg
